    function updateRoundShareChart(history) {
        const panel = document.getElementById("round-share-panel");
        const canvas = document.getElementById("roundShareChart");
        const note = document.getElementById("round-history-search-note");
        if (!canvas || !note || panel?.hidden) {
            if (roundShareChartInstance) {
                roundShareChartInstance.destroy();
                roundShareChartInstance = null;
            }
            return;
        }
        const ctx = canvas.getContext("2d");

        if (roundShareChartInstance) {
            roundShareChartInstance.destroy();
            roundShareChartInstance = null;
        }

        if (!history || history.length === 0) {
            note.innerText = "";
            return;
        }

        const displayHistory = roundHistoryDisplayOrder(history);
        const totalsByAddress = new Map();
        const chartTitle = activeUiMode === "lottery"
            ? "Recent Paid Share"
            : activeUiMode === "business"
                ? "Paid Share By Address"
                : "Paid Share By Address Across Recent Rounds";
        displayHistory.forEach(entry => {
            (entry.paidRecipients || []).forEach(recipient => {
                const key = recipient.address || recipient.username || "unknown";
                totalsByAddress.set(key, (totalsByAddress.get(key) || 0) + (recipient.totalValue || 0));
            });
        });

        let topAddresses = [...totalsByAddress.entries()]
            .sort((a, b) => b[1] - a[1])
            .slice(0, 4)
            .map(entry => entry[0]);
        const searchedAddress = currentSearchValue()
            ? [...totalsByAddress.keys()].find(address => normalizeSearchValue(address).includes(currentSearchValue()))
            : null;
        if (searchedAddress && !topAddresses.includes(searchedAddress)) {
            if (topAddresses.length >= 4) {
                topAddresses[topAddresses.length - 1] = searchedAddress;
            } else {
                topAddresses.push(searchedAddress);
            }
        }

        const labels = displayHistory.map(entry => `R${entry.roundNumber}`);
        const colors = ["#bd59ff", "#39d98a", "#ffc857", "#4ea8de", "#666666"];
        const datasets = topAddresses.map((address, index) => ({
            label: formatMinerLabel(address),
            data: displayHistory.map(entry => {
                const total = entry.paidTotalValue || 0;
                const match = (entry.paidRecipients || []).find(item => item.address === address);
                return total ? (((match?.totalValue || 0) / total) * 100) : 0;
            }),
            backgroundColor: colors[index % colors.length]
        }));

        const hasOther = displayHistory.some(entry => {
            const totalKnown = (entry.paidRecipients || [])
                .filter(item => topAddresses.includes(item.address))
                .reduce((sum, item) => sum + (item.totalValue || 0), 0);
            return totalKnown < (entry.paidTotalValue || 0);
        });

        if (hasOther) {
            datasets.push({
                label: "Other",
                data: displayHistory.map(entry => {
                    const total = entry.paidTotalValue || 0;
                    const totalKnown = (entry.paidRecipients || [])
                        .filter(item => topAddresses.includes(item.address))
                        .reduce((sum, item) => sum + (item.totalValue || 0), 0);
                    return total ? (((total - totalKnown) / total) * 100) : 0;
                }),
                backgroundColor: colors[4]
            });
        }

        roundShareChartInstance = new Chart(ctx, {
            type: "bar",
            data: {
                labels: labels,
                datasets: datasets
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: "bottom",
                        labels: {
                            color: "#888"
                        }
                    },
                    title: {
                        display: true,
                        text: chartTitle,
                        color: "#888"
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return `${context.dataset.label}: ${context.raw.toFixed(1)}%`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        stacked: true,
                        ticks: { color: "#888" },
                        grid: { display: false }
                    },
                    y: {
                        stacked: true,
                        beginAtZero: true,
                        max: 100,
                        ticks: {
                            color: "#888",
                            callback: function(value) {
                                return `${value}%`;
                            }
                        },
                        grid: { color: "#333", drawBorder: false }
                    }
                }
            }
        });

        if (currentSearchValue()) {
            const avgPaidShare = displayHistory.reduce((sum, entry) => {
                const share = computeRecipientShare(entry.paidRecipients, entry.paidTotalValue);
                return sum + (share ? share.percent : 0);
            }, 0) / displayHistory.length;
            note.innerText = activeUiMode === "lottery"
                ? `Search match average paid share across these recent rounds: ${avgPaidShare.toFixed(1)}%.`
                : `Search match average paid share across these rounds: ${avgPaidShare.toFixed(1)}%.`;
        } else {
            note.innerText = activeUiMode === "lottery"
                ? "Search an address to highlight whether it was getting paid in recent rounds."
                : "Use the search box to see a per-round share percentage for a specific address.";
        }
    }

    function copyPubKey(feedbackId = "copy-feedback") {
        if (!fullServerPubKey) return;
        navigator.clipboard.writeText(fullServerPubKey).then(() => {
            const feedback = document.getElementById(feedbackId);
            if (!feedback) return;
            feedback.innerText = "COPIED!";
            setTimeout(() => feedback.innerText = "", 2000);
        });
    }

    function shortenHash(value) {
        if (!value) return "--";
        if (value.length <= 18) return value;
        return `${value.substring(0, 8)}...${value.substring(value.length - 8)}`;
    }

    function toggleModal(modalId) {
        const modal = document.getElementById(modalId);
        modal.style.display = modal.style.display === 'flex' ? 'none' : 'flex';
    }

