    function renderPeerTable(peers) {
        const tableBody = document.querySelector('#peer-list tbody');
        tableBody.innerHTML = '';

        if (!peers || peers.length === 0) {
            tableBody.innerHTML = '<tr><td colspan="6">No peers connected yet.</td></tr>';
            return;
        }

        peers.forEach(peer => {
            const latency = peer.latencyMs == null ? '--' : `${peer.latencyMs.toFixed(0)} ms`;
            const lastSeen = peer.lastSeenUtc ? new Date(peer.lastSeenUtc).toLocaleString() : '--';
            const shortNode = peer.nodeId ? peer.nodeId.substring(0, 12) : "unknown";
            const endpointLabel = formatEndpointForDisplay(peer.endpoint, peer.nodeId);
            const mode = peer.connectionMode || (peer.endpoint ? "public" : "outbound-only");
            const capabilities = Array.isArray(peer.capabilities) && peer.capabilities.length > 0
                ? ` · ${peer.capabilities.join(", ")}`
                : "";
            const compatStatus = peer.compatibilityStatus || "unknown";
            const remoteVersion = peer.remoteVersion || {};
            const compatReason = peer.compatibilityReason || "";
            const compatWarnings = Array.isArray(peer.compatibilityWarnings) && peer.compatibilityWarnings.length > 0
                ? ` Warnings: ${peer.compatibilityWarnings.join(" ")}`
                : "";
            const compatTitle = [
                compatReason,
                `remote consensus=${remoteVersion.consensusVersion || remoteVersion.protocolVersion || "--"}`,
                `state schema=${remoteVersion.stateBundleSchemaVersion || "--"}`,
                `transport=${remoteVersion.peerTransportVersion || "--"}`,
                `api=${remoteVersion.httpApiVersion || "--"}`,
                `release=${remoteVersion.releaseVersion || "--"}`,
                compatWarnings
            ].filter(Boolean).join(" · ");
            const row = `<tr>
                    <td title="${escapeHtml(peer.nodeId ? `Node ID: ${peer.nodeId}` : "Endpoint hidden")}">${escapeHtml(endpointLabel)}</td>
                    <td title="${escapeHtml(`session=${peer.sessionConnected ? "connected" : "disconnected"}${capabilities}`)}">${escapeHtml(mode)}</td>
                    <td>${escapeHtml(peer.status || '--')}</td>
                    <td title="${escapeHtml(compatTitle)}">${escapeHtml(compatStatus)}</td>
                    <td>${escapeHtml(latency)}</td>
                    <td>${escapeHtml(lastSeen)}</td>
                </tr>`;
            tableBody.innerHTML += row;
        });
    }

    function formatRoundTriggerMode(state) {
        if (!state) return "--";
        return state.testingRoundResetEnabled ? "TEST" : "BLOCK";
    }

    function renderLaunchReadiness(state) {
        const status = document.getElementById("launch-ready-status");
        const note = document.getElementById("launch-readiness-note");
        const readiness = state?.launchReadiness;
        if (!readiness) {
            status.innerText = "--";
            note.innerText = "";
            return;
        }

        status.innerText = readiness.productionRoundModeActive ? "GRIDPOOL BLOCK" : "TEST TRIGGER";
        const warnings = readiness.warnings || [];
        const info = readiness.info || [];
        const summary = readiness.statusSummary ? `${readiness.statusSummary} ` : "";
        const hardening = readiness.operatorProductionHardeningReady
            ? "Operator hardening: production-ready."
            : "Operator hardening: beta/dev settings remain.";
        const payout = readiness.mainnetPayoutsReal
            ? "Mainnet coinbase outputs are real BTC; verify your template before mining."
            : "Test network only; no mainnet BTC.";
        const warningText = warnings.length > 0 ? ` Warnings: ${warnings.join(" ")}` : "";
        note.innerText = `${summary}${payout} ${hardening}${warningText} ${info.join(" ")}`.trim();
    }

    async function triggerManualReset() {
        const status = document.getElementById('admin-reset-status');
        const apiKey = document.getElementById('admin-api-key').value.trim();

        if (!apiKey) {
            status.innerText = "Enter the admin API key first.";
            return;
        }

        status.innerText = "Resetting round...";

        try {
            const response = await fetch('/api/network/admin/reset', {
                method: 'POST',
                headers: {
                    'X-Boot-Admin-Key': apiKey
                }
            });

            const payload = await response.json().catch(() => null);
            if (!response.ok) {
                status.innerText = payload?.reason || 'Reset failed.';
                return;
            }

            status.innerText = `Reset complete. New state: ${shortenHash(payload?.networkStatus?.currentStateId || payload?.lockedStateBundle?.stateId || '')}`;
        } catch (error) {
            console.error(error);
            status.innerText = 'Reset request failed.';
        }
    }

    function getDisplayRows(tableId, list) {
        const normalizedList = list || [];
        if (currentSearchTerm || listViewModes[tableId] !== 'summary' || normalizedList.length <= 12) {
            return {
                rows: normalizedList,
                summarized: false,
                omittedCount: 0
            };
        }

        const headCount = 5;
        const tailCount = 5;
        const head = normalizedList.slice(0, headCount);
        const tailStart = Math.max(head.length, normalizedList.length - tailCount);
        const tail = normalizedList.slice(tailStart);
        const omittedCount = Math.max(0, normalizedList.length - head.length - tail.length);
        const rows = [...head];

        if (omittedCount > 0) {
            rows.push({ __omitted: true, omittedCount: omittedCount });
        }

        rows.push(...tail);
        return {
            rows: rows,
            summarized: omittedCount > 0,
            omittedCount: omittedCount
        };
    }

    function updateListSummary(tableId, list, displayMeta) {
        const prefix = tableId === "winners-list" ? "winners" : "ondeck";
        const labels = getModeListLabels();
        const label = tableId === "winners-list" ? labels.winners : labels.ondeck;
        document.getElementById(`${prefix}-summary-btn`).classList.toggle('active', listViewModes[tableId] === 'summary');
        document.getElementById(`${prefix}-full-btn`).classList.toggle('active', listViewModes[tableId] === 'full');

        const note = document.getElementById(`${prefix}-summary-note`);
        const total = (list || []).length;

        if (currentSearchTerm) {
            note.innerText = `Search active. Showing all ${total} ${label.toLowerCase()} slots.`;
            return;
        }

        if (total === 0) {
            note.innerText = `No entries on the ${label.toLowerCase()} yet.`;
            return;
        }

        if (displayMeta.summarized) {
            note.innerText = `Showing top 5 and bottom 5 of ${total} ${label.toLowerCase()} slots.`;
            return;
        }

        note.innerText = `Showing all ${total} ${label.toLowerCase()} slots.`;
    }

    function updateTable(tableId, list) {
        const tableBody = document.querySelector(`#${tableId} tbody`);
        tableBody.innerHTML = '';
        const displayMeta = getDisplayRows(tableId, list);
        updateListSummary(tableId, list, displayMeta);

        if (tableId === "winners-list") {
            const finderLabel = activeUiMode === "lottery"
                ? "Your finder slot"
                : activeUiMode === "business"
                    ? "Finder slot"
                    : "[YourAddressHere]";
            const finderValue = activeUiMode === "nerd" ? "1 share + fees" : "Finder share + fees";
            tableBody.innerHTML += `<tr class="static-row"><td>${finderLabel}</td><td>${finderValue}</td><td>>NetworkDiff</td></tr>`;
        }

        if (!list) return;

        displayMeta.rows.forEach(payout => {
            if (payout.__omitted) {
                tableBody.innerHTML += `<tr class="omitted-row"><td colspan="3">${payout.omittedCount} additional shared slots hidden</td></tr>`;
                return;
            }

            const btcValue = payout.value / 100000000.0;
            const useFullLabel = listViewModes[tableId] === 'full';
            const formattedAddr = escapeHtml(formatAttributionLabel(payout, useFullLabel));
            const diffVal = payout.difficulty || 0;
            const diffDisplay = payout.diffString || diffVal.toLocaleString(undefined, {maximumFractionDigits: 2});

            // CHECK FOR SEARCH HIGHLIGHT
            let rowClass = "";
            if (minerMatchesSearch(payout)) {
                rowClass = "highlight-row";
            }

            const row = `<tr class="${rowClass}">
                    <td class="${useFullLabel ? 'full-label' : 'compact-label'}" title="${attributionTitle(payout)}">${formattedAddr}</td>
                    <td>${btcValue.toFixed(8)}</td>
                    <td>${diffDisplay}</td>
                </tr>`;
            tableBody.innerHTML += row;
        });
    }

    // --- CHART LOGIC WITH VERTICAL LINES ---

    function updateChart(canvasId, list, chartTitle, chartInstanceRef) {
        const ctx = document.getElementById(canvasId).getContext('2d');
        const plotData = list.map(x => x.difficulty).reverse();
        const labels = list.map((_, index) => list.length - index);
        const isLogScale = chartScaleMode === "log";

        //const bubbleData = currentSearchTerm && list.find(x => x.address === currentSearchTerm) ?
        //    list.sort((a, b) => a.difficulty - b.difficulty).map(x => x.address === currentSearchTerm ? x.difficulty : NaN) : [];
        
        // FIX: Use [...list] to create a shallow copy before sorting
        const bubbleData = currentSearchTerm && list.find(x => minerMatchesSearch(x)) ?
            [...list].sort((a, b) => a.difficulty - b.difficulty).map(x => minerMatchesSearch(x) ? x.difficulty : NaN) : [];

        const accentColor = getComputedStyle(document.documentElement).getPropertyValue('--accent-color').trim();

        const datasets = [{
            label: 'Difficulty',
            data: plotData,
            borderColor: accentColor,
            backgroundColor: accentColor + '33',
            borderWidth: 2,
            pointRadius: 0, // Hide points normally
            pointHoverRadius: 4,
            fill: true,
            tension: 0.2
        }];

        if (bubbleData.length > 0) {
            datasets.push({
                label: 'Your Difficulty',
                type: 'bubble',
                data: bubbleData,
                borderColor: '#fff',
                backgroundColor: '#fff',
                borderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 8,
                fill: false,
            });
        }

        if (chartInstanceRef) chartInstanceRef.destroy();

        // We attach the raw list to the config so the plugin can read it
        const newChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: datasets
            },
            _rawList: list, // Custom property to pass data to plugin
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                plugins: {
                    legend: {display: false},
                    title: {display: true, text: `${chartTitle} (${isLogScale ? "log" : "linear"} scale)`, color: '#888'},
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return `Diff: ${context.raw.toLocaleString()}`;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        type: isLogScale ? 'logarithmic' : 'linear',
                        beginAtZero: !isLogScale,
                        min: isLogScale ? 1 : 0,
                        grid: {color: '#333', drawBorder: false},
                        ticks: {
                            color: '#888', callback: function (value) {
                                if (value > 1000000) return (value / 1000000).toFixed(1) + 'M';
                                if (value > 1000) return (value / 1000).toFixed(0) + 'K';
                                return value;
                            }
                        }
                    },
                    x: {grid: {display: false}, ticks: {display: false}}
                }
            }
        });
        return newChart;
    }

    // --- SIGNALR HANDLERS ---

    connection.on("UpdateWinners", (list) => {
        globalWinnersList = list || [];
        // If a search is active, this will redraw with highlights
        if (currentSearchTerm) {
            performSearch({ forceLocalLookup: false });
        } else {
            refreshUI();
        }
    });

    connection.on("UpdateOnDeck", (list) => {
        globalOnDeckList = list || [];
        if (currentSearchTerm) {
            performSearch({ forceLocalLookup: false });
        } else {
            refreshUI();
        }
    });

    connection.on("UpdateRecord", (record) => {
        if (record) {
            const difficulty = Number(record.difficulty ?? record.Difficulty) || 0;
            const minerAddress = record.minerAddress ?? record.MinerAddress ?? "";
            const timestamp = record.timestamp ?? record.Timestamp ?? null;
            document.getElementById("record-diff").innerText = formatDifficultyDisplay(difficulty);
            document.getElementById("record-miner").innerText = minerAddress ? formatAddress(minerAddress) : "--";
            document.getElementById("record-time").innerText = timestamp ? new Date(timestamp).toLocaleString() : "--";
        }
    });

    connection.on("UpdateRoundHistory", (history) => {
        globalRoundHistory = history || [];
        if (shouldRenderRoundHistory()) {
            renderRoundHistory(globalRoundHistory);
        }
    });

    connection.on("UpdateServerInfo", (info) => {
        fullServerPubKey = info.pubKey;
        document.getElementById("server-host").innerText = info.datumHost || "--";
        document.getElementById("server-port").innerText = info.poolPort;
        if (info.pubKey && info.pubKey.length > 16) {
            const first = info.pubKey.substring(0, 8);
            const last = info.pubKey.substring(info.pubKey.length - 8);
            document.getElementById("server-pubkey-display").innerText = `${first}...${last}`;
        } else {
            document.getElementById("server-pubkey-display").innerText = info.pubKey;
        }
        syncConnectionInfoPanel(info);
        updateConnectPanelVisibility();
        renderModeSummaryCards();
        renderModeFocusSection();
    });

    connection.on("UpdateNetworkState", (state) => {
        if (!state) return;
        latestNetworkState = state;
        updateEnvironmentChrome(state);
        document.getElementById("self-endpoint").innerText = formatEndpointForDisplay(
            state.selfEndpoint,
            state.nodeId,
            "Private / outbound-only");
        document.getElementById("network-id").innerText = state.networkId || "--";
        document.getElementById("consensus-version").innerText = state.consensusVersion || state.protocolVersion || "--";
        document.getElementById("state-schema-version").innerText = state.stateBundleSchemaVersion || "--";
        document.getElementById("transport-api-version").innerText = `P2P ${state.peerTransportVersion || "--"} / API ${state.httpApiVersion || "--"}`;
        document.getElementById("release-version").innerText = state.releaseVersion || "--";
        document.getElementById("current-round-number").innerText = state.currentRoundNumber ?? "--";
        document.getElementById("template-slot-count").innerText = `${state.totalPayoutSlotCount ?? '--'} total (${state.sharedWinnerSlotCount ?? '--'} shared + slot 0)`;
        document.getElementById("peer-count").innerText = state.peerCount ?? 0;
        document.getElementById("current-state-id").innerText = shortenHash(state.currentStateId);
        document.getElementById("candidate-state-id").innerText = shortenHash(state.candidateStateId);
        document.getElementById("testing-trigger-status").innerText = state.testingRoundResetEnabled ? "ACTIVE" : "disabled";
        document.getElementById("last-testing-trigger-block").innerText = state.lastTestingTriggerBlockHash
            ? formatBlockLabel(state.lastTestingTriggerBlockHash, state.lastTestingTriggerBlockHeight)
            : "--";
        document.getElementById("commitment-preview").innerText = state.commitment?.tagPreview || "--";
        document.getElementById("commitment-note").innerText = state.commitment?.supportNote || "";
        document.getElementById("testing-trigger-note").innerText = state.testingRoundResetDescription || "";
        renderLaunchReadiness(state);
        renderPeerTable(state.peers || []);
        renderLocalDatumDiagnostics();
        renderLocalMinerShortcuts();
        maybeAutoselectLocalMiner();
        refreshSelectedLocalMinerSummary();
        updateCurrentRoundTelemetry();
        scheduleHashrateHistoryChartRender();
        updateModeChrome();
        renderModeSummaryCards();
        renderModeFocusSection();
    });

    async function start() {
        try {
            document.getElementById("chart-linear-btn").classList.toggle("active", chartScaleMode === "linear");
            document.getElementById("chart-log-btn").classList.toggle("active", chartScaleMode === "log");
            document.getElementById("hashrate-scale-linear-btn").classList.toggle("active", hashrateScaleMode === "linear");
            document.getElementById("hashrate-scale-log-btn").classList.toggle("active", hashrateScaleMode === "log");
            await connection.start();
            await connection.invoke("GetInitialData");
            await setHashrateWindow(hashrateWindow);
            await loadBitcoinNetworkMetrics();
        } catch (err) {
            console.error(err);
            setTimeout(start, 5000);
        }
    };

    currentRoundEstimateTimer = setInterval(() => {
        updateCurrentRoundTelemetry();
    }, 1000);

    hashrateChartRefreshTimer = setInterval(() => {
        scheduleHashrateHistoryChartRender();
    }, HASHRATE_CHART_RENDER_INTERVAL_MS);

    setInterval(() => {
        loadHashrateSeries();
    }, 60000);

    setInterval(() => {
        refreshSelectedLocalMinerSummary();
    }, 30000);

    setInterval(() => {
        loadBitcoinNetworkMetrics();
    }, 300000);

    start();
</script>
</body>
</html>
