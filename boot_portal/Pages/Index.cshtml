    function formatTimestamp(value) {
        if (!value) return "--";
        return new Date(value).toLocaleString();
    }

    function formatBlockLabel(hash, height) {
        if (height != null) return `Block ${height.toLocaleString()}`;
        return `Block ${shortenHash(hash)}`;
    }

    function getBlockExplorerUrl(hash) {
        if (!hash) return null;
        return `https://mempool.space/block/${hash}`;
    }

    function describeRoundKind(kind) {
        if (!kind) return "round";
        if (kind.startsWith("test-trigger:")) return "test";
        if (kind === "manual-rotation") return "manual";
        if (kind === "manual-reset") return "manual";
        if (kind.startsWith("adopted-state:")) return "adopted";
        if (kind.startsWith("bootstrap-state:")) return "bootstrap";
        return String(kind).replace(/[^A-Za-z0-9 :_.-]/g, "_").replace(/[:_]/g, " ");
    }

    function roundHistoryDisplayOrder(history) {
        if (roundHistoryOrder === "newest-left") {
            return [...history];
        }

        return [...history].reverse();
    }

    function setRoundHistoryOrder(order) {
        roundHistoryOrder = order === "newest-left" ? "newest-left" : "oldest-left";
        localStorage.setItem("boot-round-history-order", roundHistoryOrder);
        document.getElementById("rounds-oldest-left-btn").classList.toggle("active", roundHistoryOrder === "oldest-left");
        document.getElementById("rounds-newest-left-btn").classList.toggle("active", roundHistoryOrder === "newest-left");
        renderRoundHistory(globalRoundHistory);
    }

    function setChartScaleMode(mode) {
        chartScaleMode = mode === "log" ? "log" : "linear";
        localStorage.setItem("boot-chart-scale-mode", chartScaleMode);
        document.getElementById("chart-linear-btn").classList.toggle("active", chartScaleMode === "linear");
        document.getElementById("chart-log-btn").classList.toggle("active", chartScaleMode === "log");
        refreshUI();
    }

    async function setHashrateWindow(windowKey) {
        hashrateWindow = ["6h", "24h", "7d", "30d", "all"].includes(windowKey) ? windowKey : "24h";
        localStorage.setItem("boot-hashrate-window", hashrateWindow);
        ["6h", "24h", "7d", "30d", "all"].forEach(key => {
            document.getElementById(`hashrate-window-${key}-btn`).classList.toggle("active", hashrateWindow === key);
        });
        await loadHashrateSeries();
        await refreshSelectedLocalMinerSummary(true);
    }

    function setHashrateScaleMode(mode) {
        hashrateScaleMode = mode === "log" ? "log" : "linear";
        localStorage.setItem("boot-hashrate-scale-mode", hashrateScaleMode);
        document.getElementById("hashrate-scale-linear-btn").classList.toggle("active", hashrateScaleMode === "linear");
        document.getElementById("hashrate-scale-log-btn").classList.toggle("active", hashrateScaleMode === "log");
        scheduleHashrateHistoryChartRender(true);
    }

    async function loadHashrateSeries() {
        try {
            const response = await fetch(`/api/network/hashrate?window=${encodeURIComponent(hashrateWindow)}`);
            if (!response.ok) {
                throw new Error(`Hashrate series request failed with ${response.status}`);
            }

            globalHashrateSeries = await response.json();
            scheduleHashrateHistoryChartRender(true);
        } catch (error) {
            console.error(error);
            document.getElementById("round-hashrate-chart-note").innerText = "Failed to load sampled hashrate series.";
        }
    }

    function getHashrateWindowCutoff(windowKey) {
        const now = Date.now();
        switch (windowKey) {
            case "6h":
                return now - (6 * 60 * 60 * 1000);
            case "24h":
                return now - (24 * 60 * 60 * 1000);
            case "7d":
                return now - (7 * 24 * 60 * 60 * 1000);
            case "30d":
                return now - (30 * 24 * 60 * 60 * 1000);
            default:
                return null;
        }
    }

    function formatHashratePointLabel(timestampMs, isCurrentPoint) {
        if (isCurrentPoint) {
            return "Now";
        }

        const date = new Date(timestampMs);
        switch (hashrateWindow) {
            case "6h":
            case "24h":
                return date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
            case "7d":
            case "30d":
                return date.toLocaleDateString([], { month: "short", day: "numeric" });
            default:
                return `${date.toLocaleDateString([], { month: "short", day: "numeric" })} ${date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}`;
        }
    }

    function getHashrateChartMaxPoints() {
        return window.innerWidth <= 700
            ? HASHRATE_CHART_MAX_POINTS_MOBILE
            : HASHRATE_CHART_MAX_POINTS_DESKTOP;
    }

    function smoothTeamHashratePoints(points) {
        const window = [];
        let windowSum = 0;

        return points.map(point => {
            const value = Number(point.teamHashrateThs);
            if (value > 0) {
                window.push({ timestampMs: point.timestampMs, value: value });
                windowSum += value;
            }

            while (window.length > 0 && (point.timestampMs - window[0].timestampMs) > TEAM_HASHRATE_SMOOTHING_WINDOW_MS) {
                windowSum -= window[0].value;
                window.shift();
            }

            const smoothedTeamHashrateThs = window.length > 0 ? (windowSum / window.length) : point.teamHashrateThs;
            return {
                ...point,
                smoothedTeamHashrateThs: smoothedTeamHashrateThs,
                smoothedTeamDisplay: formatHashrateFromThs(smoothedTeamHashrateThs)
            };
        });
    }

    function downsampleHashratePoints(points, maxPoints) {
        if (!Array.isArray(points) || points.length <= maxPoints || maxPoints <= 0) {
            return points;
        }

        const currentPoint = points[points.length - 1]?.isCurrent ? points[points.length - 1] : null;
        const historicalPoints = currentPoint ? points.slice(0, -1) : [...points];
        const targetHistoricalCount = Math.max(1, maxPoints - (currentPoint ? 1 : 0));

        if (historicalPoints.length <= targetHistoricalCount) {
            return currentPoint ? [...historicalPoints, currentPoint] : historicalPoints;
        }

        const bucketSize = Math.ceil(historicalPoints.length / targetHistoricalCount);
        const reduced = [];

        for (let index = 0; index < historicalPoints.length; index += bucketSize) {
            const bucket = historicalPoints.slice(index, index + bucketSize);
            const last = bucket[bucket.length - 1];
            const teamValues = bucket
                .map(point => Number(point.smoothedTeamHashrateThs))
                .filter(value => Number.isFinite(value) && value > 0);
            const localValues = bucket
                .map(point => Number(point.localHashrateThs))
                .filter(value => Number.isFinite(value) && value > 0);
            const averageTeamHashrateThs = teamValues.length > 0
                ? teamValues.reduce((sum, value) => sum + value, 0) / teamValues.length
                : last.smoothedTeamHashrateThs;
            const averageLocalHashrateThs = localValues.length > 0
                ? localValues.reduce((sum, value) => sum + value, 0) / localValues.length
                : last.localHashrateThs;

            reduced.push({
                ...last,
                smoothedTeamHashrateThs: averageTeamHashrateThs,
                smoothedTeamDisplay: formatHashrateFromThs(averageTeamHashrateThs),
                localHashrateThs: averageLocalHashrateThs,
                localDisplay: formatHashrateFromThs(averageLocalHashrateThs)
            });
        }

        return currentPoint ? [...reduced, currentPoint] : reduced;
    }

    function downsampleSelectedMinerPoints(points, maxPoints) {
        if (!Array.isArray(points) || points.length <= maxPoints || maxPoints <= 0) {
            return points;
        }

        const currentPoint = points[points.length - 1]?.isCurrent ? points[points.length - 1] : null;
        const historicalPoints = currentPoint ? points.slice(0, -1) : [...points];
        const targetHistoricalCount = Math.max(1, maxPoints - (currentPoint ? 1 : 0));
        if (historicalPoints.length <= targetHistoricalCount) {
            return currentPoint ? [...historicalPoints, currentPoint] : historicalPoints;
        }

        const bucketSize = Math.ceil(historicalPoints.length / targetHistoricalCount);
        const reduced = [];
        for (let index = 0; index < historicalPoints.length; index += bucketSize) {
            const bucket = historicalPoints.slice(index, index + bucketSize);
            const last = bucket[bucket.length - 1];
            const values = bucket
                .map(point => Number(point.hashrateThs))
                .filter(value => Number.isFinite(value) && value > 0);
            const averageHashrateThs = values.length > 0
                ? values.reduce((sum, value) => sum + value, 0) / values.length
                : last.hashrateThs;
            reduced.push({
                ...last,
                hashrateThs: averageHashrateThs,
                hashrateDisplay: formatHashrateFromThs(averageHashrateThs)
            });
        }

        return currentPoint ? [...reduced, currentPoint] : reduced;
    }

    function getSelectedMinerChartPoints() {
        const selectedMiner = getSelectedLocalMinerSummary();
        if (!currentSearchValue() || !selectedMiner) {
            return [];
        }

        const points = (Array.isArray(selectedLocalMinerSeries?.points) ? selectedLocalMinerSeries.points : [])
            .filter(point => point && point.timestampUtc)
            .map(point => ({
                timestampMs: new Date(point.timestampUtc).getTime(),
                hashrateThs: point.hashrateThs,
                hashrateDisplay: point.hashrateDisplay || formatHashrateFromThs(point.hashrateThs),
                sampleCount: point.sampleCount
            }))
            .filter(point => Number.isFinite(point.timestampMs) && Number(point.hashrateThs) > 0)
            .sort((a, b) => a.timestampMs - b.timestampMs);

        const currentHashrateThs = selectedMiner.currentHashrateThs ?? null;
        if (currentHashrateThs != null && currentHashrateThs > 0) {
            const currentTimestampMs = Date.now();
            const lastPoint = points[points.length - 1];
            if (!lastPoint || Math.abs(currentTimestampMs - lastPoint.timestampMs) > 2000) {
                points.push({
                    timestampMs: currentTimestampMs,
                    hashrateThs: currentHashrateThs,
                    hashrateDisplay: selectedMiner.currentHashrateDisplay || formatHashrateFromThs(currentHashrateThs),
                    sampleCount: selectedMiner.hashrateSampleCount,
                    isCurrent: true
                });
            } else {
                lastPoint.hashrateThs = currentHashrateThs;
                lastPoint.hashrateDisplay = selectedMiner.currentHashrateDisplay || formatHashrateFromThs(currentHashrateThs);
                lastPoint.sampleCount = selectedMiner.hashrateSampleCount;
                lastPoint.isCurrent = true;
            }
        }

        return downsampleSelectedMinerPoints(points, getHashrateChartMaxPoints());
    }

    function scheduleHashrateHistoryChartRender(immediate = false) {
        const now = Date.now();
        const delayMs = immediate
            ? 0
            : Math.max(0, HASHRATE_CHART_RENDER_INTERVAL_MS - (now - lastHashrateChartRenderMs));

        if (scheduledHashrateChartRender) {
            if (!immediate) return;
            clearTimeout(scheduledHashrateChartRender);
            scheduledHashrateChartRender = null;
        }

        scheduledHashrateChartRender = setTimeout(() => {
            scheduledHashrateChartRender = null;
            lastHashrateChartRenderMs = Date.now();
            updateHashrateHistoryChart();
        }, delayMs);
    }

    function updateCurrentRoundTelemetry() {
        const elapsedSeconds = getCurrentRoundElapsedSeconds();
        const estimatedHashrateThs = getCurrentRoundEstimatedHashrateThs();
        const estimatedDisplay = formatHashrateFromThs(estimatedHashrateThs);
        const localMiningHashrateThs = latestNetworkState?.localMiningHashrateThs
            ?? latestNetworkState?.localDatumHashrateThs;
        const localMiningDisplay = formatHashrateFromThs(localMiningHashrateThs);

        document.getElementById("current-round-age").innerText = formatElapsedSeconds(
            elapsedSeconds ?? latestNetworkState?.currentRoundElapsedSeconds
        );
        document.getElementById("current-round-hashrate").innerText =
            (estimatedDisplay !== "--" ? estimatedDisplay : null) ||
            latestNetworkState?.currentRoundObservedHashrateDisplay ||
            "--";
        document.getElementById("local-mining-hashrate").innerText =
            (localMiningDisplay !== "--" ? localMiningDisplay : null) ||
            latestNetworkState?.localMiningHashrateDisplay ||
            latestNetworkState?.localDatumHashrateDisplay ||
            "--";
        renderLocalMiningSources();
    }

    function renderLocalMiningSources() {
        const containers = [...document.querySelectorAll("[data-local-mining-sources]")];
        if (containers.length === 0) return;

        const summaries = new Map(
            (Array.isArray(latestNetworkState?.localMiningSources) ? latestNetworkState.localMiningSources : [])
                .map(summary => [String(summary.source || "").toLowerCase(), summary])
        );
        const expectedSources = [
            ["datum", "DATUM"],
            ["ckpool", "CKPool"],
            ["hydrapool", "Hydrapool"],
            ["sv2", "Stratum V2"],
            ["http", "Direct HTTP"]
        ];
        const extraSources = [...summaries.entries()]
            .filter(([source]) => !expectedSources.some(([expected]) => expected === source))
            .map(([source, summary]) => [source, summary.displayName || source]);

        const html = [...expectedSources, ...extraSources].map(([source, displayName]) => {
            const summary = summaries.get(source);
            const hashrate = summary?.currentHashrateDisplay || "--";
            const miners = Number(summary?.activeMinerCount || 0);
            const samples = Number(summary?.hashrateSampleCount || 0);
            const method = summary?.estimationMethod === "client-api"
                ? "client API"
                : summary?.estimationMethod === "reported-work"
                    ? "assigned-share work"
                : summary?.estimationMethod === "reported-work-and-proofs"
                    ? "work + proofs"
                    : summary?.estimationMethod === "proof-order-statistic"
                        ? "proof estimate"
                        : samples > 0
                            ? "warming up"
                            : "no recent data";
            const status = summary ? (miners > 0 ? "active" : "connected") : "idle";
            return `<div class="local-mining-source-row">
                <span class="local-mining-source-name">${escapeHtml(displayName)}</span>
                <span class="accent-value">${escapeHtml(hashrate)}</span>
                <span class="local-mining-source-meta">${escapeHtml(status)} · ${miners} miner${miners === 1 ? "" : "s"} · ${samples.toLocaleString()} samples · ${escapeHtml(method)}</span>
            </div>`;
        }).join("");
        containers.forEach(container => {
            container.innerHTML = html;
        });
    }

    function updateHashrateHistoryChart() {
        const canvas = document.getElementById("roundHashrateChart");
        const note = document.getElementById("round-hashrate-chart-note");
        const ctx = canvas.getContext("2d");

        if (roundHashrateChartInstance) {
            roundHashrateChartInstance.destroy();
            roundHashrateChartInstance = null;
        }

        const points = smoothTeamHashratePoints([...(globalHashrateSeries?.points || [])]
            .filter(point => point && point.timestampUtc)
            .map(point => ({
                roundNumber: point.currentRoundNumber,
                timestampMs: new Date(point.timestampUtc).getTime(),
                label: `R${point.currentRoundNumber}`,
                teamHashrateThs: point.teamEstimatedHashrateThs,
                teamDisplay: point.teamEstimatedHashrateDisplay || formatHashrateFromThs(point.teamEstimatedHashrateThs),
                localHashrateThs: point.localDatumHashrateThs,
                localDisplay: point.localDatumHashrateDisplay || formatHashrateFromThs(point.localDatumHashrateThs)
            })));

        const currentHashrateThs = getCurrentRoundEstimatedHashrateThs();
        const currentLocalDatumHashrateThs = latestNetworkState?.localMiningHashrateThs
            ?? latestNetworkState?.localDatumHashrateThs
            ?? null;
        const currentTimestampMs = Date.now();
        if ((currentHashrateThs != null || currentLocalDatumHashrateThs != null)) {
            points.push({
                roundNumber: latestNetworkState?.currentRoundNumber,
                timestampMs: currentTimestampMs,
                label: `R${latestNetworkState?.currentRoundNumber ?? "?"}`,
                teamHashrateThs: currentHashrateThs,
                teamDisplay: formatHashrateFromThs(currentHashrateThs),
                smoothedTeamHashrateThs: currentHashrateThs,
                smoothedTeamDisplay: formatHashrateFromThs(currentHashrateThs),
                localHashrateThs: currentLocalDatumHashrateThs,
                localDisplay: formatHashrateFromThs(currentLocalDatumHashrateThs),
                isCurrent: true
            });

            const currentPoint = points[points.length - 1];
            const smoothingValues = points
                .filter(point => point.teamHashrateThs != null && (currentTimestampMs - point.timestampMs) <= TEAM_HASHRATE_SMOOTHING_WINDOW_MS)
                .map(point => Number(point.teamHashrateThs))
                .filter(value => Number.isFinite(value) && value > 0);

            if (smoothingValues.length > 0) {
                currentPoint.smoothedTeamHashrateThs = smoothingValues.reduce((sum, value) => sum + value, 0) / smoothingValues.length;
                currentPoint.smoothedTeamDisplay = formatHashrateFromThs(currentPoint.smoothedTeamHashrateThs);
            }
        }

        const displayPoints = downsampleHashratePoints(points, getHashrateChartMaxPoints());

        if (displayPoints.length === 0) {
            note.innerText = "Not enough completed round data yet for a hashrate timeline.";
            return;
        }

        const selectedMinerPoints = getSelectedMinerChartPoints();
        const teamData = displayPoints
            .map(point => ({
                x: point.timestampMs,
                y: point.smoothedTeamHashrateThs ?? point.teamHashrateThs,
                point: point
            }))
            .filter(item => Number(item.y) > 0);
        const localDatumData = displayPoints
            .map(point => ({
                x: point.timestampMs,
                y: point.localHashrateThs,
                point: point
            }))
            .filter(item => Number(item.y) > 0);
        const selectedMinerData = selectedMinerPoints
            .map(point => ({
                x: point.timestampMs,
                y: point.hashrateThs,
                point: point
            }))
            .filter(item => Number(item.y) > 0);
        const positiveValues = [...teamData, ...localDatumData, ...selectedMinerData]
            .map(item => Number(item.y) || 0)
            .filter(value => value > 0);
        const hasPositiveValues = positiveValues.length > 0;
        const positiveMin = hasPositiveValues ? Math.min(...positiveValues) : null;
        const useLogScale = hashrateScaleMode === "log" && hasPositiveValues;
        const accentColor = getComputedStyle(document.documentElement).getPropertyValue('--accent-color').trim();
        const localColor = "#39d98a";
        const selectedMinerColor = "#f5b84b";
        const selectedMiner = getSelectedLocalMinerSummary();
        const hasLocalDatumLine = localDatumData.length > 0;
        const hasSelectedMinerLine = selectedMinerData.length > 0;
        const chartTitle = hasSelectedMinerLine
            ? "Team / Local / Selected Miner Hashrate"
            : activeUiMode === "lottery"
            ? "Team Hashrate Through Time"
            : activeUiMode === "business"
                ? "Team Hashrate"
                : "Sampled Team Hashrate";

        const datasets = [{
            label: "Team Estimate (30m avg)",
            data: teamData,
            borderColor: accentColor,
            backgroundColor: `${accentColor}33`,
            borderWidth: 2,
            pointRadius: teamData.map(item => item.point.isCurrent ? 4 : 2),
            pointHoverRadius: teamData.map(item => item.point.isCurrent ? 6 : 4),
            fill: true,
            tension: 0.25
        }];

        if (hasLocalDatumLine) {
            datasets.push({
                label: "Local Mining",
                data: localDatumData,
                borderColor: localColor,
                backgroundColor: `${localColor}22`,
                borderWidth: 2,
                pointRadius: localDatumData.map(item => item.point.isCurrent ? 4 : 2),
                pointHoverRadius: localDatumData.map(item => item.point.isCurrent ? 6 : 4),
                fill: false,
                tension: 0.2
            });
        }

        if (hasSelectedMinerLine) {
            datasets.push({
                label: `Selected Miner${selectedMiner?.currentHashrateDisplay ? ` (${selectedMiner.currentHashrateDisplay})` : ""}`,
                data: selectedMinerData,
                borderColor: selectedMinerColor,
                backgroundColor: `${selectedMinerColor}22`,
                borderWidth: 2,
                borderDash: [6, 4],
                pointRadius: selectedMinerData.map(item => item.point.isCurrent ? 4 : 2),
                pointHoverRadius: selectedMinerData.map(item => item.point.isCurrent ? 6 : 4),
                fill: false,
                tension: 0.2
            });
        }

        roundHashrateChartInstance = new Chart(ctx, {
            type: "line",
            data: {
                datasets: datasets
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: false,
                parsing: false,
                normalized: true,
                resizeDelay: 150,
                plugins: {
                    legend: {
                        display: true,
                        position: "bottom",
                        labels: { color: "#888" }
                    },
                    title: {
                        display: true,
                        text: chartTitle,
                        color: "#888"
                    },
                    tooltip: {
                        callbacks: {
                            title: function(context) {
                                const raw = context[0].raw;
                                const point = raw?.point;
                                const label = point?.label ? `${point.label} · ` : "";
                                return `${label}${new Date(raw.x).toLocaleString()}`;
                            },
                            label: function(context) {
                                const point = context.raw?.point;
                                if (context.dataset.label?.startsWith("Team")) {
                                    return `Team: ${point?.smoothedTeamDisplay || point?.teamDisplay || formatHashrateFromThs(context.raw?.y)}`;
                                }
                                if (context.dataset.label?.startsWith("Local Mining")) {
                                    return `Local Mining: ${point?.localDisplay || formatHashrateFromThs(context.raw?.y)}`;
                                }
                                return `Selected miner: ${point?.hashrateDisplay || formatHashrateFromThs(context.raw?.y)}`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        type: "linear",
                        ticks: {
                            color: "#888",
                            maxRotation: 0,
                            autoSkip: true,
                            callback: function(value) {
                                return formatHashratePointLabel(Number(value), Math.abs(Date.now() - Number(value)) < 15000);
                            }
                        },
                        grid: { display: false }
                    },
                    y: {
                        type: useLogScale ? "logarithmic" : "linear",
                        beginAtZero: !useLogScale,
                        min: useLogScale && positiveMin != null ? Math.max(positiveMin * 0.8, positiveMin / 1.5) : undefined,
                        ticks: {
                            color: "#888",
                            callback: function(value) {
                                return formatHashrateFromThs(value);
                            }
                        },
                        grid: { color: "#333", drawBorder: false }
                    }
                }
            }
        });

        const currentPoint = displayPoints[displayPoints.length - 1];
        const historyOnlyPoints = points.filter(point => !point.isCurrent && point.teamHashrateThs != null);
        const averageHashrateThs = historyOnlyPoints.length > 0
            ? historyOnlyPoints.reduce((sum, point) => sum + (point.smoothedTeamHashrateThs ?? point.teamHashrateThs), 0) / historyOnlyPoints.length
            : null;
        const localWindowMinutes = Math.round((globalHashrateSeries?.localWindowSeconds || 1800) / 60);
        const scaleText = hashrateScaleMode === "log" ? "Log scale emphasizes relative swings and prevents one lucky spike from flattening the rest of the series." : "Linear scale shows absolute swings in estimated hashrate.";
        const localDatumText = hasLocalDatumLine
            ? "Green line is aggregate local mining hashrate sampled over the full selected chart window."
            : "Local mining history appears once this node has sampled direct-share hashrate.";
        const selectedMinerText = hasSelectedMinerLine
            ? `Orange dashed line is the selected payout address over the rolling ${localWindowMinutes}-minute direct-share window.`
            : "Search or click an active local payout address to add its individual miner hashrate line.";
        if (activeUiMode === "lottery") {
            note.innerText = currentPoint?.isCurrent && averageHashrateThs != null
                ? `Team line is smoothed over the last 30 minutes to suppress reset spikes. Recent average: ${formatHashrateFromThs(averageHashrateThs)}. ${localDatumText} ${selectedMinerText} ${scaleText}`
                : `This chart shows the team hashrate smoothed over the last 30 minutes from recent winning-quality shares. ${localDatumText} ${selectedMinerText} ${scaleText}`;
            return;
        }

        if (activeUiMode === "business") {
            note.innerText = currentPoint?.isCurrent && averageHashrateThs != null
                ? `Team line is a 30-minute smoothing window. Team window average: ${formatHashrateFromThs(averageHashrateThs)}. ${localDatumText} ${selectedMinerText} ${scaleText}`
                : `${localDatumText} ${selectedMinerText} ${scaleText}`;
            return;
        }

        note.innerText = currentPoint?.isCurrent && averageHashrateThs != null
            ? `Live team line uses a 30-minute smoothing window over the current and sampled queue estimates. Team window average: ${formatHashrateFromThs(averageHashrateThs)}. ${localDatumText} ${selectedMinerText} ${scaleText}`
            : `${localDatumText} ${selectedMinerText} ${scaleText}`;
    }

    function recipientMatchesSearch(item) {
        const term = currentSearchValue();
        if (!term) return false;
        const address = normalizeSearchValue(item.address);
        const username = normalizeSearchValue(item.username);
        return address.includes(term) || username.includes(term);
    }

    function computeRecipientShare(recipients, totalValue) {
        if (!currentSearchValue()) return null;
        const matchingValue = (recipients || [])
            .filter(recipientMatchesSearch)
            .reduce((sum, item) => sum + (item.totalValue || 0), 0);
        return {
            value: matchingValue,
            percent: totalValue ? (matchingValue / totalValue) * 100 : 0
        };
    }

    function buildRoundPreview(recipients, totalValue) {
        if (!recipients || recipients.length === 0) return "No payouts";
        return recipients.slice(0, 3).map(entry => {
            const label = formatAttributionLabel(entry);
            return `${escapeHtml(label)} ${escapeHtml(formatPercent(entry.totalValue, totalValue))}`;
        }).join(" · ");
    }

    function describeRoundStatus(entry) {
        return entry.isOrphaned ? "orphaned" : "canonical";
    }

    function renderRoundHistory(history) {
        if (!shouldRenderRoundHistory()) {
            if (roundShareChartInstance) {
                roundShareChartInstance.destroy();
                roundShareChartInstance = null;
            }
            return;
        }

        const note = document.getElementById("round-history-note");
        const scroller = document.getElementById("round-history-scroller");
        const detail = document.getElementById("round-history-detail");
        const visibleHistory = getRoundHistoryForMode();
        scroller.innerHTML = "";
        document.getElementById("rounds-oldest-left-btn").classList.toggle("active", roundHistoryOrder === "oldest-left");
        document.getElementById("rounds-newest-left-btn").classList.toggle("active", roundHistoryOrder === "newest-left");

        if (!visibleHistory || visibleHistory.length === 0) {
            note.innerText = "No completed rounds recorded yet.";
            detail.innerHTML = '<div class="round-history-empty">Completed rounds will appear here after the next lock.</div>';
            updateRoundShareChart([]);
            selectedRoundStateId = null;
            return;
        }

        const orphanedCount = (history || []).filter(entry => entry.isOrphaned).length;
        if (activeUiMode === "nerd") {
            note.innerText = `Showing the most recent ${visibleHistory.length} completed rounds (${orphanedCount} orphaned). Order is ${roundHistoryOrder === "oldest-left" ? "oldest to newest" : "newest to oldest"}.`;
        } else if (orphanedCount > 0) {
            note.innerText = `Showing ${visibleHistory.length} canonical rounds. ${orphanedCount} orphaned rounds are hidden in ${activeUiMode === "lottery" ? "Lottery" : "Business"} mode.`;
        } else {
            note.innerText = `Showing ${visibleHistory.length} canonical rounds in ${roundHistoryOrder === "oldest-left" ? "oldest to newest" : "newest to oldest"} order.`;
        }

        if (!selectedRoundStateId || !visibleHistory.some(entry => entry.stateId === selectedRoundStateId)) {
            selectedRoundStateId = visibleHistory[0].stateId;
        }

        const displayHistory = roundHistoryDisplayOrder(visibleHistory);
        displayHistory.forEach((entry) => {
            const card = document.createElement("button");
            card.type = "button";
            card.className = `round-card${entry.isOrphaned ? " orphaned" : ""}${entry.stateId === selectedRoundStateId ? " active" : ""}`;
            card.onclick = () => {
                selectedRoundStateId = entry.stateId;
                renderRoundHistory(globalRoundHistory);
            };

            const explorerUrl = getBlockExplorerUrl(entry.triggerBlockHash);
            card.innerHTML = `
                <div class="round-card-header">
                    <div class="round-card-title">Round ${entry.roundNumber}</div>
                    <div class="round-kind-pill${entry.isOrphaned ? " orphaned" : ""}">${entry.isOrphaned ? "orphan" : describeRoundKind(entry.kind)}</div>
