<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    let fullServerPubKey = "";
    let winnersChartInstance = null;
    let onDeckChartInstance = null;
    let roundShareChartInstance = null;
    let roundHashrateChartInstance = null;
    let latestNetworkState = null;
    let globalRoundHistory = [];
    let globalHashrateSeries = { points: [], sampleIntervalSeconds: 60, localWindowSeconds: 1800 };
    let selectedRoundStateId = null;
    let activeUiMode = "lottery";
    let roundHistoryOrder = localStorage.getItem("boot-round-history-order") || "oldest-left";
    let chartScaleMode = localStorage.getItem("boot-chart-scale-mode") || "linear";
    let hashrateWindow = localStorage.getItem("boot-hashrate-window") || "24h";
    let hashrateScaleMode = localStorage.getItem("boot-hashrate-scale-mode") || "linear";
    let currentRoundEstimateTimer = null;
    let hashrateChartRefreshTimer = null;
    let scheduledHashrateChartRender = null;
    let lastHashrateChartRenderMs = 0;
    let globalBitcoinMetrics = {
        currentNetworkHashrateHps: null,
        sevenDayAverageHashrateHps: null,
        lastUpdatedMs: null
    };
    let autoSelectedLocalMinerAddress = null;
    let selectedLocalMinerSummary = null;
    let selectedLocalMinerSeries = { points: [] };
    let selectedLocalMinerLookupInFlight = false;
    const MIN_LIVE_HASHRATE_ESTIMATE_SECONDS = 60;
    let lastSelectedLocalMinerLookupMs = 0;
    let userTouchedSearch = false;

    // Global state for client-side searching
    let globalWinnersList = [];
    let globalOnDeckList = [];
    let currentSearchTerm = "";
    const TEAM_HASHRATE_SMOOTHING_WINDOW_MS = 30 * 60 * 1000;
    const HASHRATE_CHART_RENDER_INTERVAL_MS = 10000;
    const HASHRATE_CHART_MAX_POINTS_DESKTOP = 240;
    const HASHRATE_CHART_MAX_POINTS_MOBILE = 120;
    const SELECTED_LOCAL_MINER_LOOKUP_INTERVAL_MS = 30000;
    const LOCAL_MINER_SHORTCUT_MIN_SAMPLES = 8;
    const GENESIS_FOUNDATION_ADDRESS = "bc1qce93hy5rhg02s6aeu7mfdvxg76x66pqqtrvzs3";
    const listViewModes = {
        "winners-list": "summary",
        "ondeck-list": "summary"
    };

    // --- INITIALIZE URL SEARCH ---
    // Checks if the URL is like /bc1q... and pre-fills the search
    window.addEventListener('DOMContentLoaded', () => {
        const path = window.location.pathname.substring(1); // Remove leading '/'
        // Simple check to ignore SignalR paths or empty paths
        if (path && path.length > 15 && !path.includes("/")) {
            const input = document.getElementById('search-input');
            input.value = path;
            currentSearchTerm = path; // Set immediate state
        }

        document.getElementById('search-input').addEventListener('input', () => {
            userTouchedSearch = true;
        });

        document.getElementById('local-miner-shortcuts')?.addEventListener('click', (event) => {
            const button = event.target.closest('.shortcut-chip');
            const address = button?.dataset?.minerAddress;
            if (address) {
                selectLocalMiner(address);
            }
        });

        const requestedMode = new URLSearchParams(window.location.search).get("mode");
        if (["lottery", "business", "nerd"].includes(requestedMode)) {
            setUiMode(requestedMode, { persist: false, resetDisclosure: true });
        } else {
            setUiMode(localStorage.getItem("boot-ui-mode") || "lottery", { persist: false, resetDisclosure: true });
        }

        updateConnectPanelVisibility();
        syncConnectionInfoPanel();
        updateEnvironmentChrome();
    });

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/poolStatsHub")
        .withAutomaticReconnect()
        .build();

    // --- SEARCH LOGIC ---
    function performSearch(options = {}) {
        const forceLocalLookup = options.forceLocalLookup !== false;
        const input = document.getElementById('search-input');
        const rawTerm = input.value.trim();
        const previousTerm = currentSearchTerm;
        currentSearchTerm = rawTerm;
        if (normalizeSearchValue(previousTerm) !== normalizeSearchValue(rawTerm)) {
            selectedLocalMinerSummary = null;
            selectedLocalMinerSeries = { points: [] };
            lastSelectedLocalMinerLookupMs = 0;
        }
        updateConnectPanelVisibility();
        const resultDiv = document.getElementById('search-results');
        const labels = getModeListLabels();

        if (!rawTerm) {
            resultDiv.innerHTML = "";
            selectedLocalMinerSummary = null;
            selectedLocalMinerSeries = { points: [] };
            refreshUI(); // Clear highlights
            return;
        }

        // 1. Scan Winners
        const winnerMatches = globalWinnersList
            .map((item, index) => ({item, index: index + 1})) // 1-based index
            .filter(x => minerMatchesSearch(x.item, normalizeSearchValue(rawTerm)));

        const winnerTotal = winnerMatches.reduce((sum, x) => sum + x.item.value, 0);

        // 2. Scan OnDeck
        const deckMatches = globalOnDeckList
            .map((item, index) => ({item, index: index + 1}))
            .filter(x => minerMatchesSearch(x.item, normalizeSearchValue(rawTerm)));

        const deckTotal = deckMatches.reduce((sum, x) => sum + x.item.value, 0);

        // 3. Build Output
        if (winnerMatches.length === 0 && deckMatches.length === 0) {
            resultDiv.innerHTML = `This address does not have any shares on the lists yet. Keep hashing!`;
        } else {
            let msg = "";
            if (deckMatches.length > 0) {
                const deckIndices = deckMatches.map(x => '#' + x.index).join(', ');
                const deckBtc = (deckTotal / 100000000.0).toFixed(8);
                msg += `<div><span class="result-highlight">${labels.ondeck}:</span> ${deckIndices}. Currently ranked, provisional value if selected: ${deckBtc} BTC</div>`;
            }
            if (winnerMatches.length > 0) {
                const winIndices = winnerMatches.map(x => '#' + x.index).join(', ');
                const winBtc = (winnerTotal / 100000000.0).toFixed(8);
                msg += `<div><span class="result-highlight">${labels.winners}:</span> ${winIndices}. Locked payout: ${winBtc} BTC</div>`;
            }
            resultDiv.innerHTML = msg;
        }

        refreshSelectedLocalMinerSummary(forceLocalLookup);

        // 4. Trigger UI Redraw to show highlights
        refreshUI();
    }

    function refreshUI() {
        const labels = getModeListLabels();
        updateConnectPanelVisibility();
        if (activeUiMode === "nerd") {
            updateTable("winners-list", globalWinnersList);
            updateTable("ondeck-list", globalOnDeckList);
        }
        if (shouldRenderRoundHistory()) {
            renderRoundHistory(globalRoundHistory);
        }
        updateCurrentRoundTelemetry();
        scheduleHashrateHistoryChartRender();
        renderModeSummaryCards();
        renderModeFocusSection();
        renderLocalMinerShortcuts();

        if (activeUiMode === "nerd") {
            // Re-draw charts with the vertical lines
            winnersChartInstance = updateChart("winnersChart", globalWinnersList, `${labels.winners} Depth`, winnersChartInstance);
            onDeckChartInstance = updateChart("onDeckChart", globalOnDeckList, `${labels.ondeck} Depth`, onDeckChartInstance);
        }
    }


    // --- STANDARD HELPERS ---
    function isTestnetState(state = latestNetworkState) {
        const bitcoinNetwork = String(state?.bitcoinNetwork || "").toLowerCase();
        const networkId = String(state?.networkId || "").toLowerCase();
        return bitcoinNetwork.includes("test") || networkId.includes("test");
    }

    function getNetworkDisplayName(state = latestNetworkState) {
        if (!state) return "Loading...";
        if (isTestnetState(state)) return "Testnet4";
        return "Mainnet";
    }

    function formatEndpointForDisplay(endpoint, nodeId = "", emptyLabel = "Private / outbound-only") {
        const raw = String(endpoint || "").trim();
        const shortNode = nodeId ? String(nodeId).substring(0, 12) : "";
        if (!raw) return shortNode ? `outbound-only node:${shortNode}` : emptyLabel;

        try {
            const parsed = new URL(raw.includes("://") ? raw : `http://${raw}`);
            const hostname = parsed.hostname.replace(/^\[|\]$/g, "").toLowerCase();
            const isIpv4 = /^(?:\d{1,3}\.){3}\d{1,3}$/.test(hostname);
            const isIpv6 = hostname.includes(":");
            const isLocalName = hostname === "localhost" || hostname.endsWith(".local");
            if (isIpv4 || isIpv6 || isLocalName) {
                return shortNode ? `node:${shortNode}` : "Endpoint hidden";
            }
            return `${hostname}${parsed.port ? `:${parsed.port}` : ""}`;
        } catch {
            return shortNode ? `node:${shortNode}` : "Endpoint hidden";
        }
    }

    function updateEnvironmentChrome(state = latestNetworkState) {
        const isTestnet = isTestnetState(state);
        document.body.classList.toggle("network-testnet", isTestnet);
        document.body.classList.toggle("network-mainnet", !isTestnet);

        const bannerTitle = document.getElementById("environment-banner-title");
        const bannerCopy = document.getElementById("environment-banner-copy");
        const badge = document.getElementById("network-badge");
        const brandTitle = document.getElementById("brand-title");
        const subtitle = document.getElementById("brand-subtitle");
        const headerNetworkName = document.getElementById("header-network-name");
        const headerNodeEndpoint = document.getElementById("header-node-endpoint");
        const headerRoundMode = document.getElementById("header-round-mode");

        if (bannerTitle) bannerTitle.innerText = isTestnet ? "Testnet4" : "Public Beta";
        if (bannerCopy) {
            bannerCopy.innerText = isTestnet
                ? "Testing network only. No real BTC. Use testnet addresses and isolated DATUM settings."
                : "Experimental non-custodial mining protocol. Mainnet payouts are real; verify your setup.";
        }
        if (badge) badge.innerText = isTestnet ? "Testnet4 beta" : "Mainnet beta";
        if (brandTitle) brandTitle.innerText = isTestnet ? "GridPool Testnet4" : "GridPool";
        if (subtitle) {
            subtitle.innerText = isTestnet
                ? "Real trigger testing for GridPool payment transitions. Test coins only."
                : "The pool for cypherpunks. Sovereign templates, shared variance, no pool wallet.";
        }
        if (headerNetworkName) headerNetworkName.innerText = state ? `${getNetworkDisplayName(state)} · ${state.networkId || "--"}` : "Loading...";
        if (headerNodeEndpoint) {
            headerNodeEndpoint.innerText = formatEndpointForDisplay(
                state?.selfEndpoint || window.location.host,
                state?.nodeId,
                "Private node");
        }
        if (headerRoundMode) headerRoundMode.innerText = state ? formatRoundTriggerMode(state) : "--";
        document.title = isTestnet ? "GridPool Testnet4" : "GridPool";
    }

    function formatAddress(address) {
        if (!address) return "Unknown";
        const dotIndex = address.indexOf('.');
        let mainPart = address;
        let suffix = "";
        if (dotIndex !== -1) {
            mainPart = address.substring(0, dotIndex);
            suffix = address.substring(dotIndex);
        }
        if (mainPart.length <= 12) return address;
        const first6 = mainPart.substring(0, 6);
        const last6 = mainPart.substring(mainPart.length - 6);
        return `${first6}...${last6}${suffix}`;
    }

    function formatMinerLabel(value) {
        if (!value) return "Unknown";
        const text = String(value);
        const dotIndex = text.indexOf('.');
        const address = dotIndex === -1 ? text : text.substring(0, dotIndex);
        const worker = dotIndex === -1 ? "" : text.substring(dotIndex + 1);
        const shortAddress = address.length <= 6 ? address : address.substring(address.length - 6);
        const shortWorker = worker ? `.${worker.substring(0, 6)}` : "";
        return `${shortAddress}${shortWorker}`;
    }

    function escapeHtml(value) {
        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#39;");
    }

    function getBaseMinerAddress(value) {
        if (!value) return "";
        const text = String(value);
        const dotIndex = text.indexOf('.');
        return dotIndex === -1 ? text : text.substring(0, dotIndex);
    }

    function getAttributionAddress(item) {
        return item?.address || item?.minerAddress || getBaseMinerAddress(item?.username) || "";
    }

    function getWorkerSuffix(item) {
        const username = item?.username ? String(item.username) : "";
        const dotIndex = username.indexOf('.');
        if (dotIndex < 0 || dotIndex === username.length - 1) return "";
        return username.substring(dotIndex);
    }

    function formatAttributionLabel(item, full = false) {
        const address = getAttributionAddress(item);
        const label = `${address || "Unknown"}${getWorkerSuffix(item)}`;
        return full ? label : formatMinerLabel(label);
    }

    function attributionTitle(item) {
        const label = formatAttributionLabel(item, true);
        const submitted = item?.username || "";
        const submittedBase = getBaseMinerAddress(submitted);
        const credited = getAttributionAddress(item);
        if (submitted && submittedBase && credited && normalizeSearchValue(submittedBase) !== normalizeSearchValue(credited)) {
            return escapeHtml(`Credited to ${label}; submitted username ${submitted}`);
        }
        return escapeHtml(label);
    }

    function minerMatchesSearch(item, term = currentSearchValue()) {
        if (!term) return false;
        const address = normalizeSearchValue(getAttributionAddress(item));
        const username = normalizeSearchValue(item?.username);
        return address.includes(term) || username.includes(term);
    }

    function formatBtcFromSats(value) {
        return ((value || 0) / 100000000.0).toFixed(8);
    }

    function formatPercent(part, total) {
        if (!total) return "0.0%";
        return `${((part / total) * 100).toFixed(1)}%`;
    }

    function formatElapsedSeconds(value) {
        if (value == null) return "--";
        const total = Math.max(0, Number(value));
        const hours = Math.floor(total / 3600);
        const minutes = Math.floor((total % 3600) / 60);
        const seconds = Math.floor(total % 60);

        if (hours > 0) return `${hours}h ${minutes}m ${seconds}s`;
        if (minutes > 0) return `${minutes}m ${seconds}s`;
        return `${seconds}s`;
    }

    function formatDiagnosticWindow(windowSeconds) {
        if (!windowSeconds || windowSeconds <= 0) return "--";
        const hours = windowSeconds / 3600;
        if (hours >= 24 && Number.isInteger(hours / 24)) return `${hours / 24}d`;
        if (Number.isInteger(hours)) return `${hours}h`;
        return formatElapsedSeconds(windowSeconds);
    }

    function formatAcceptanceRate(accepted, total) {
        if (!total) return "--";
        return `${((accepted / total) * 100).toFixed(1)}%`;
    }

    function renderLocalDatumDiagnostics() {
        const diagnostics = latestNetworkState?.localDatumDiagnostics || {};
        const reasons = Array.isArray(diagnostics.rejectionReasons) ? diagnostics.rejectionReasons : [];
        const totalSubmissions = diagnostics.totalSubmissions ?? 0;
        const acceptedCount = diagnostics.acceptedCount ?? 0;
        const onDeckCount = diagnostics.acceptedOnDeckCount ?? 0;
        const rejectedCount = diagnostics.rejectedCount ?? 0;

        document.getElementById("datum-diagnostic-window").innerText = formatDiagnosticWindow(diagnostics.windowSeconds);
        document.getElementById("datum-accepted-count").innerText = acceptedCount.toLocaleString();
        document.getElementById("datum-ondeck-count").innerText = onDeckCount.toLocaleString();
        document.getElementById("datum-rejected-count").innerText = rejectedCount.toLocaleString();
        document.getElementById("datum-acceptance-rate").innerText = formatAcceptanceRate(acceptedCount, totalSubmissions);

        const reasonText = reasons.length > 0
            ? `Top rejects: ${reasons.map(item => `${item.reason} (${item.count})`).join(", ")}`
            : "Top rejects: none";
        document.getElementById("datum-rejection-note").innerText = reasonText;
    }

    function estimateRankAdjustedHashrateThs(difficulties, elapsedSeconds) {
        if (!Array.isArray(difficulties) || difficulties.length === 0) return null;
        if (elapsedSeconds == null || elapsedSeconds <= 0) return null;

        const ranked = difficulties
            .map(value => Number(value) || 0)
            .filter(value => value > 0)
            .sort((a, b) => b - a);
        if (ranked.length === 0) return null;

        const estimates = ranked
            .map((difficulty, index) => ((index + 1) * difficulty * 4294967296) / elapsedSeconds / 1_000_000_000_000)
            .sort((a, b) => a - b);

        const middle = Math.floor(estimates.length / 2);
        if (estimates.length % 2 === 1) {
            return estimates[middle];
        }

        return (estimates[middle - 1] + estimates[middle]) / 2;
    }

    function formatHashrateFromThs(hashrateThs) {
        if (hashrateThs == null || !isFinite(hashrateThs) || hashrateThs <= 0) return "--";
        const hashesPerSecond = hashrateThs * 1_000_000_000_000;
        if (hashesPerSecond >= 1_000_000_000_000_000_000) return `${trimHashratePrecision(hashesPerSecond / 1_000_000_000_000_000_000)} EH/s`;
        if (hashesPerSecond >= 1_000_000_000_000_000) return `${trimHashratePrecision(hashesPerSecond / 1_000_000_000_000_000)} PH/s`;
        if (hashesPerSecond >= 1_000_000_000_000) return `${trimHashratePrecision(hashesPerSecond / 1_000_000_000_000)} TH/s`;
        if (hashesPerSecond >= 1_000_000_000) return `${trimHashratePrecision(hashesPerSecond / 1_000_000_000)} GH/s`;
        return `${hashesPerSecond.toFixed(0)} H/s`;
    }

    function trimHashratePrecision(value) {
        return value.toFixed(2).replace(/\.00$/, "").replace(/(\.\d)0$/, "$1");
    }

    function getCurrentRoundElapsedSeconds() {
        if (!latestNetworkState?.lastRotationUtc) {
            return latestNetworkState?.currentRoundElapsedSeconds ?? null;
        }

        const startedAt = new Date(latestNetworkState.lastRotationUtc).getTime();
        if (Number.isNaN(startedAt)) {
            return latestNetworkState?.currentRoundElapsedSeconds ?? null;
        }

        return Math.max(0, Math.floor((Date.now() - startedAt) / 1000));
    }

    function getCurrentRoundEstimatedHashrateThs() {
        if (Number(latestNetworkState?.currentRoundObservedHashrateThs) > 0) {
            return latestNetworkState.currentRoundObservedHashrateThs;
        }

        const elapsedSeconds = getCurrentRoundElapsedSeconds();
        if (elapsedSeconds == null || elapsedSeconds < MIN_LIVE_HASHRATE_ESTIMATE_SECONDS) {
            return null;
        }

        const difficulties = (globalOnDeckList || [])
            .map(item => Number(item.difficulty) || 0)
            .filter(value => value > 0);
        return estimateRankAdjustedHashrateThs(difficulties, elapsedSeconds);
    }

    function normalizeSearchValue(value) {
        return (value || "").toLowerCase();
    }

    function currentSearchValue() {
        return normalizeSearchValue(currentSearchTerm);
    }

    function setUiMode(mode, options = {}) {
        activeUiMode = ["lottery", "business", "nerd"].includes(mode) ? mode : "lottery";

        if (options.persist !== false) {
            localStorage.setItem("boot-ui-mode", activeUiMode);
        }

        document.body.dataset.uiMode = activeUiMode;
        document.getElementById("mode-lottery-btn").classList.toggle("active", activeUiMode === "lottery");
        document.getElementById("mode-business-btn").classList.toggle("active", activeUiMode === "business");
        document.getElementById("mode-nerd-btn").classList.toggle("active", activeUiMode === "nerd");

        updateModeChrome(options.resetDisclosure === true);
        if (options.skipRefresh) {
            renderModeSummaryCards();
            renderModeFocusSection();
            return;
        }

        refreshUI();
    }

    function setElementHidden(id, hidden) {
        const element = document.getElementById(id);
        if (element) {
            element.hidden = !!hidden;
        }
    }

    function hasSelectedPayoutAddress() {
        return !!currentSearchTerm.trim();
    }

    function updateConnectPanelVisibility() {
        setElementHidden("connect-panel", hasSelectedPayoutAddress());
    }

    function syncConnectionInfoPanel(info = null) {
        const host = info?.datumHost || document.getElementById("server-host")?.innerText || "--";
        const port = info?.poolPort ?? document.getElementById("server-port")?.innerText ?? "--";
        const pubKey = info?.pubKey || fullServerPubKey || "";
        const pubKeyDisplay = pubKey && pubKey.length > 16
            ? `${pubKey.substring(0, 8)}...${pubKey.substring(pubKey.length - 8)}`
            : (pubKey || "--");

        const connectHost = document.getElementById("connect-host");
        const connectPort = document.getElementById("connect-port");
        const connectPubkey = document.getElementById("connect-pubkey-display");
        if (connectHost) connectHost.innerText = host || "--";
        if (connectPort) connectPort.innerText = port || "--";
        if (connectPubkey) connectPubkey.innerText = pubKeyDisplay;
    }

    function focusAddressSearch() {
        const input = document.getElementById("search-input");
        input?.focus();
    }

    function getCanonicalRoundHistory(limit = null) {
        const canonical = (globalRoundHistory || []).filter(entry => !entry?.isOrphaned);
        return limit == null ? canonical : canonical.slice(0, limit);
    }

    function getRoundHistoryForMode() {
        if (activeUiMode === "nerd") {
            return globalRoundHistory || [];
        }

        return getCanonicalRoundHistory();
    }

    function shouldRenderRoundHistory() {
        return activeUiMode !== "lottery";
    }

    function getModeListLabels() {
        switch (activeUiMode) {
            case "lottery":
                return { winners: "Active Payout Snapshot", ondeck: "Unpaid Work Set" };
            case "business":
                return { winners: "Active Payout Snapshot", ondeck: "Unpaid Work Set" };
            default:
                return { winners: "Active Payout Snapshot", ondeck: "Unpaid Work Set" };
        }
    }

    function getSearchContext() {
        const term = currentSearchValue();
        const winnerMatches = !term ? [] : globalWinnersList.filter(item => minerMatchesSearch(item, term));
        const onDeckMatches = !term ? [] : globalOnDeckList.filter(item => minerMatchesSearch(item, term));
        const winnerBestDifficulty = getBestDifficultyFromItems(winnerMatches);
        const onDeckBestDifficulty = getBestDifficultyFromItems(onDeckMatches);
        const recentCanonicalRounds = getCanonicalRoundHistory(12);
        const paidRounds = term
            ? recentCanonicalRounds.filter(entry => (computeRecipientShare(entry.paidRecipients, entry.paidTotalValue)?.value || 0) > 0)
            : [];
        const nextRounds = term
            ? recentCanonicalRounds.filter(entry => (computeRecipientShare(entry.nextRecipients, entry.nextWinnerTotalValue)?.value || 0) > 0)
            : [];

        const avgPaidShare = paidRounds.length > 0
            ? paidRounds.reduce((sum, entry) => sum + (computeRecipientShare(entry.paidRecipients, entry.paidTotalValue)?.percent || 0), 0) / paidRounds.length
            : 0;

        return {
            hasSearch: !!term,
            winnerMatches,
            onDeckMatches,
            winnerSlots: winnerMatches.length,
            onDeckSlots: onDeckMatches.length,
            winnerValue: winnerMatches.reduce((sum, item) => sum + (item.value || 0), 0),
            onDeckValue: onDeckMatches.reduce((sum, item) => sum + (item.value || 0), 0),
            winnerBestDifficulty,
            onDeckBestDifficulty,
            bestDifficulty: Math.max(winnerBestDifficulty, onDeckBestDifficulty),
            paidRounds,
            nextRounds,
            recentCanonicalRounds,
            avgPaidShare
        };
    }

    function getBestDifficultyFromItems(items) {
        return (items || [])
            .map(item => Number(item?.difficulty) || 0)
            .reduce((best, value) => Math.max(best, value), 0);
    }

    function getSelectedMinerBestDifficulty(search = null, localMiner = null) {
        const searchBest = Number((search || getSearchContext()).bestDifficulty) || 0;
        const localBest = Number((localMiner || getSelectedLocalMinerSummary())?.currentRoundBestDifficulty) || 0;
        return Math.max(searchBest, localBest);
    }

    function getSelectedMinerBestDifficultyDisplay(search = null, localMiner = null) {
        return formatDifficultyDisplay(getSelectedMinerBestDifficulty(search, localMiner));
    }

    function getLatestMatchingRound(rounds, recipientSelector) {
        const entries = rounds || [];
        for (const entry of entries) {
            const share = recipientSelector(entry);
            if (share && share.value > 0) {
                return { entry, share };
            }
        }

        return null;
    }

    function formatRoundReference(entry) {
        if (!entry) return "--";
        return `Round ${entry.roundNumber} · ${formatBlockLabel(entry.triggerBlockHash, entry.triggerBlockHeight)}`;
    }

    function summarizeRecentMatchingRounds(rounds, recipientSelector, limit = 3) {
        const lines = [];
        for (const entry of rounds || []) {
            const share = recipientSelector(entry);
            if (!share || share.value <= 0) continue;
            lines.push(`${formatRoundReference(entry)} · ${share.percent.toFixed(1)}% · ${formatBtcFromSats(share.value)} BTC`);
            if (lines.length >= limit) break;
        }

        return lines;
    }

    function currentTeamHashrateThs() {
        return getCurrentRoundEstimatedHashrateThs()
            ?? latestNetworkState?.currentRoundObservedHashrateThs
            ?? null;
    }

    function currentTeamHashrateDisplay() {
        const formatted = formatHashrateFromThs(currentTeamHashrateThs());
        return formatted !== "--"
            ? formatted
            : (latestNetworkState?.currentRoundObservedHashrateDisplay || "--");
    }

    function setModeCard(index, kicker, title, value, detail, note = "") {
        document.getElementById(`mode-card-${index}-kicker`).innerText = kicker;
        document.getElementById(`mode-card-${index}-title`).innerText = title;
        document.getElementById(`mode-card-${index}-value`).innerText = value;
        document.getElementById(`mode-card-${index}-detail`).innerText = detail;
        document.getElementById(`mode-card-${index}-note`).innerText = note;
    }

    function buildFocusMetric(label, value) {
        return `<div class="mode-focus-metric"><span>${label}</span><strong>${value}</strong></div>`;
    }

    function buildFocusCard(kicker, value, bodyHtml, note = "", listItems = []) {
        const listHtml = listItems.length > 0
            ? `<div class="mode-focus-list">${listItems.map(item => `<div class="mode-focus-list-item">${item}</div>`).join("")}</div>`
            : "";

        return `
            <div class="mode-focus-card">
                <div class="mode-focus-kicker">${kicker}</div>
                <div class="mode-focus-value">${value}</div>
                <div class="mode-focus-body">${bodyHtml || ""}</div>
                ${note ? `<div class="mode-focus-note">${note}</div>` : ""}
                ${listHtml}
            </div>
        `;
    }

    function getConnectionSummary() {
        const host = document.getElementById("server-host")?.innerText || "--";
        const port = document.getElementById("server-port")?.innerText || "--";
        const endpoint = host && port && host !== "Loading..." && port !== "Loading..."
            ? `${host}:${port}`
            : "--";
        const pubkey = fullServerPubKey && fullServerPubKey.length > 16
            ? `${fullServerPubKey.substring(0, 8)}...${fullServerPubKey.substring(fullServerPubKey.length - 8)}`
            : (fullServerPubKey || "--");
        return { endpoint, pubkey };
    }

    function isActiveLocalDatumMiner(miner) {
        const hashrate = Number(miner?.currentHashrateThs);
        return (Number.isFinite(hashrate) && hashrate > 0) ||
            Number(miner?.hashrateSampleCount || 0) > 0 ||
            Number(miner?.recentAcceptedShareCount || 0) > 0;
    }

    function localMinerUsernameHasDifferentAddress(miner) {
        const address = normalizeSearchValue(miner?.address);
        const username = normalizeSearchValue(miner?.username);
        if (!username || username === address) return false;

        return username
            .split(/[.,;:/\\|\s]+/)
            .some(token => token.startsWith("bc1") && token !== address);
    }

    function isTemporaryFoundationLocalDatumMiner(miner) {
        return normalizeSearchValue(miner?.address) === GENESIS_FOUNDATION_ADDRESS &&
            localMinerUsernameHasDifferentAddress(miner);
    }

    function isDisplayableLocalDatumMiner(miner) {
        return isActiveLocalDatumMiner(miner) &&
            Number(miner?.hashrateSampleCount || 0) >= LOCAL_MINER_SHORTCUT_MIN_SAMPLES &&
            !isTemporaryFoundationLocalDatumMiner(miner);
    }

    function getLocalDatumMiners() {
        const miners = Array.isArray(latestNetworkState?.localDatumMiners) ? latestNetworkState.localDatumMiners : [];
        const byAddress = new Map();
        miners
            .filter(isDisplayableLocalDatumMiner)
            .forEach(miner => {
                const key = normalizeSearchValue(miner.address);
                if (!key) return;
                const existing = byAddress.get(key);
                if (!existing || Number(miner.currentHashrateThs || 0) > Number(existing.currentHashrateThs || 0)) {
                    byAddress.set(key, miner);
                }
            });
        return [...byAddress.values()];
    }

    function getSelectedLocalMinerSummary() {
        const miners = getLocalDatumMiners();
        const term = currentSearchValue();
        if (term) {
            const addressMatch = miners.find(miner => normalizeSearchValue(miner.address).includes(term));
            if (addressMatch) return addressMatch;
            const localMatch = miners.find(miner => normalizeSearchValue(miner.username).includes(term));
            if (localMatch) return localMatch;
            if (selectedLocalMinerSummary &&
                isActiveLocalDatumMiner(selectedLocalMinerSummary) &&
                normalizeSearchValue(selectedLocalMinerSummary.address).includes(term)) {
                return selectedLocalMinerSummary;
            }
            if (selectedLocalMinerSummary &&
                isActiveLocalDatumMiner(selectedLocalMinerSummary) &&
                normalizeSearchValue(selectedLocalMinerSummary.username).includes(term)) {
                return selectedLocalMinerSummary;
            }
            return null;
        }

        return miners.length === 1 ? miners[0] : null;
    }

    async function refreshSelectedLocalMinerSummary(force = false) {
        const rawTerm = currentSearchTerm.trim();
        if (!rawTerm || selectedLocalMinerLookupInFlight) return;
        const now = Date.now();
        if (!force && (now - lastSelectedLocalMinerLookupMs) < SELECTED_LOCAL_MINER_LOOKUP_INTERVAL_MS) return;

        lastSelectedLocalMinerLookupMs = now;
        selectedLocalMinerLookupInFlight = true;
        try {
            const response = await fetch(`/api/network/local-miners?address=${encodeURIComponent(rawTerm)}&limit=1&window=${encodeURIComponent(hashrateWindow)}`);
            if (!response.ok) return;
            const payload = await response.json();
            const miners = Array.isArray(payload?.miners) ? payload.miners : [];
            selectedLocalMinerSummary = miners.find(isActiveLocalDatumMiner) || null;
            selectedLocalMinerSeries = selectedLocalMinerSummary ? payload : { points: [] };
            renderModeSummaryCards();
            renderModeFocusSection();
            scheduleHashrateHistoryChartRender(true);
            renderLocalMinerShortcuts();
        } catch (err) {
            console.warn("Failed to load local miner hashrate summary", err);
        } finally {
            selectedLocalMinerLookupInFlight = false;
        }
    }

    function selectLocalMiner(address) {
        const input = document.getElementById("search-input");
        if (!input || !address) return;
        input.value = address;
        userTouchedSearch = false;
        performSearch();
        refreshSelectedLocalMinerSummary(true);
        renderLocalMinerShortcuts();
    }

    function maybeAutoselectLocalMiner() {
        const miners = getLocalDatumMiners();
        const input = document.getElementById("search-input");
        if (!input || miners.length !== 1) return;
        if (currentSearchTerm || input.value.trim() || userTouchedSearch) return;
        if (autoSelectedLocalMinerAddress === miners[0].address) return;

        autoSelectedLocalMinerAddress = miners[0].address;
        input.value = miners[0].address;
        performSearch();
    }

    function renderLocalMinerShortcuts() {
        const container = document.getElementById("local-miner-shortcuts");
        const miners = getLocalDatumMiners();
        const selected = getSelectedLocalMinerSummary();

        if (!container) return;
        if (miners.length === 0) {
            container.hidden = true;
            container.innerHTML = "";
            return;
        }

        container.hidden = false;
        container.innerHTML = miners.map(miner => `
            <button type="button" class="shortcut-chip${selected?.address === miner.address ? " active" : ""}" data-miner-address="${escapeHtml(miner.address)}" title="${escapeHtml(miner.address)}">
                <span class="shortcut-chip-label">Local Miner</span>
                <span class="shortcut-chip-value">${escapeHtml(formatMinerLabel(miner.address))}</span>
                <span class="shortcut-chip-note">${escapeHtml(miner.currentHashrateDisplay || "--")} · best since snapshot ${escapeHtml(miner.currentRoundBestDifficultyDisplay || "--")}</span>
            </button>
        `).join("");
    }

    async function loadBitcoinNetworkMetrics() {
        try {
            const response = await fetch("https://mempool.space/api/v1/mining/hashrate/1m");
            if (!response.ok) {
                throw new Error(`Network metrics request failed with ${response.status}`);
            }

            const payload = await response.json();
            const points = Array.isArray(payload?.hashrates) ? payload.hashrates : [];
            if (points.length === 0) {
                return;
            }

            const current = Number(points[points.length - 1]?.avgHashrate) || null;
            const trailingWindow = points
                .slice(-7)
                .map(point => Number(point?.avgHashrate) || 0)
                .filter(value => value > 0);

            globalBitcoinMetrics = {
                currentNetworkHashrateHps: current,
                sevenDayAverageHashrateHps: trailingWindow.length > 0
                    ? trailingWindow.reduce((sum, value) => sum + value, 0) / trailingWindow.length
                    : current,
                lastUpdatedMs: Date.now()
            };

            renderModeSummaryCards();
            renderModeFocusSection();
        } catch (error) {
            console.error(error);
        }
    }

    function hashrateThsToHps(hashrateThs) {
        if (hashrateThs == null || !isFinite(hashrateThs) || hashrateThs <= 0) return null;
        return hashrateThs * 1_000_000_000_000;
    }

    function getBitcoinNetworkHashrateHps(preferSevenDay = false) {
        return preferSevenDay
            ? (globalBitcoinMetrics.sevenDayAverageHashrateHps || globalBitcoinMetrics.currentNetworkHashrateHps)
            : globalBitcoinMetrics.currentNetworkHashrateHps;
    }

    function getBitcoinNetworkDifficulty(preferSevenDay = false) {
        const networkHashrateHps = getBitcoinNetworkHashrateHps(preferSevenDay);
        if (!networkHashrateHps) return null;
        return (networkHashrateHps * 600) / 4294967296;
    }

    function getBlocksUntilNextHalving() {
        const height = Number(latestNetworkState?.currentTipBlockHeight);
        if (!Number.isFinite(height) || height < 0) return null;
        const nextHalvingHeight = (Math.floor(height / 210000) + 1) * 210000;
        return Math.max(0, nextHalvingHeight - height);
    }

    function poissonProbabilityAtLeastOne(ratePerSecond, seconds) {
        if (ratePerSecond == null || seconds == null || ratePerSecond <= 0 || seconds <= 0) return null;
        return 1 - Math.exp(-ratePerSecond * seconds);
    }

    function quantileTimeForPoissonEvent(ratePerSecond, confidence) {
        if (ratePerSecond == null || ratePerSecond <= 0 || confidence <= 0 || confidence >= 1) return null;
        return -Math.log(1 - confidence) / ratePerSecond;
    }

    function formatDurationLong(seconds) {
        if (seconds == null || !isFinite(seconds) || seconds <= 0) return "--";
        const total = Math.floor(seconds);
        const days = Math.floor(total / 86400);
        const hours = Math.floor((total % 86400) / 3600);
        const minutes = Math.floor((total % 3600) / 60);

        if (days >= 365) return `${(days / 365).toFixed(days >= 730 ? 0 : 1)} years`;
        if (days >= 30) return `${(days / 30).toFixed(days >= 180 ? 0 : 1)} months`;
        if (days >= 7) return `${(days / 7).toFixed(days >= 28 ? 0 : 1)} weeks`;
        if (days > 0) return `${days}d ${hours}h`;
        if (hours > 0) return `${hours}h ${minutes}m`;
        if (minutes > 0) return `${minutes}m`;
        return `${total}s`;
    }

    function formatChance(probability) {
        if (probability == null || !isFinite(probability) || probability <= 0) return "--";
        if (probability >= 0.995) return ">99.5%";
        if (probability >= 0.10) return `${(probability * 100).toFixed(0)}%`;
        if (probability >= 0.01) return `${(probability * 100).toFixed(1)}%`;
        const oneIn = Math.max(1, Math.round(1 / probability));
        return `1 in ${oneIn.toLocaleString()}`;
    }

    function formatChanceDetail(probability) {
        if (probability == null || !isFinite(probability) || probability <= 0) return "--";
        if (probability >= 0.01) {
            return `${(probability * 100).toFixed(probability >= 0.1 ? 0 : 1)}%`;
        }

        return formatChance(probability);
    }

    function getTeamBlockFindRatePerSecond(hashrateThs, preferSevenDay = false) {
        const networkHashrateHps = getBitcoinNetworkHashrateHps(preferSevenDay);
        const hashrateHps = hashrateThsToHps(hashrateThs);
        if (!networkHashrateHps || !hashrateHps) return null;
        return (hashrateHps / networkHashrateHps) / 600;
    }

    function getShareThresholdHitRatePerSecond(hashrateThs, difficulty) {
        const hashrateHps = hashrateThsToHps(hashrateThs);
        if (!hashrateHps || difficulty == null || difficulty <= 0) return null;
        return hashrateHps / (difficulty * 4294967296);
    }

    function getSharedSlotModel(localHashrateThs, teamHashrateThs) {
        const slotCount = Number(latestNetworkState?.sharedWinnerSlotCount ?? 299);
        if (!Number.isFinite(localHashrateThs) || localHashrateThs <= 0
            || !Number.isFinite(teamHashrateThs) || teamHashrateThs <= 0
            || !Number.isFinite(slotCount) || slotCount <= 0) {
            return null;
        }

        const hashrateShare = Math.max(0, Math.min(1, localHashrateThs / teamHashrateThs));
        return {
            slotCount,
            expectedSlots: slotCount * hashrateShare,
            probabilityAtLeastOneSlot: 1 - Math.pow(1 - hashrateShare, slotCount)
        };
    }

    function getCurrentOnDeckThresholdDifficulty() {
        const difficulties = (globalOnDeckList || [])
            .map(item => Number(item.difficulty) || 0)
            .filter(value => value > 0);
        if (difficulties.length === 0) return null;
        return Math.min(...difficulties);
    }

    function getCurrentOnDeckThresholdDisplay() {
        const threshold = getCurrentOnDeckThresholdDifficulty();
        return threshold == null ? "--" : formatDifficultyDisplay(threshold);
    }

    function getCurrentTeamBestDifficulty() {
        const difficulties = (globalOnDeckList || [])
            .map(item => Number(item.difficulty) || 0)
            .filter(value => value > 0);
        if (difficulties.length === 0) return null;
        return Math.max(...difficulties);
    }

    function formatDifficultyDisplay(value) {
        if (value == null || !isFinite(value) || value <= 0) return "--";
        if (value < 1000) return value.toFixed(2).replace(/\.00$/, "");
        if (value < 1_000_000) return `${(value / 1_000).toFixed(2).replace(/\.00$/, "")}k`;
        if (value < 1_000_000_000) return `${(value / 1_000_000).toFixed(2).replace(/\.00$/, "")}M`;
        if (value < 1_000_000_000_000) return `${(value / 1_000_000_000).toFixed(2).replace(/\.00$/, "")}G`;
        if (value < 1_000_000_000_000_000) return `${(value / 1_000_000_000_000).toFixed(2).replace(/\.00$/, "")}T`;
        return `${(value / 1_000_000_000_000_000).toFixed(2).replace(/\.00$/, "")}P`;
    }

    function buildMetricList(items) {
        return `<div class="metric-list">${items.map(item => `
            <div class="metric-row">
                <span>${item.label}</span>
                <strong>${item.value}</strong>
            </div>
        `).join("")}</div>`;
    }

    function buildHeroPanel(title, copy, metrics) {
        return `
            <div class="mode-focus-card hero">
                <div class="mode-focus-kicker">Current Position</div>
                <div class="mode-focus-rich">
                    <div class="mode-hero-title">${title}</div>
                    <div class="mode-hero-copy">${copy}</div>
                    <div class="mode-hero-metrics">
                        ${metrics.map(metric => `
                            <div class="mode-mini-panel">
                                <div class="mode-mini-kicker">${metric.kicker}</div>
                                <strong>${metric.value}</strong>
                            </div>
                        `).join("")}
                    </div>
                </div>
            </div>
        `;
    }

    function buildDifficultyGaugeCard(localMiner) {
        const myBest = getSelectedMinerBestDifficulty(null, localMiner);
        const threshold = getCurrentOnDeckThresholdDifficulty();
        const teamBest = getCurrentTeamBestDifficulty();
        const networkDifficulty = getBitcoinNetworkDifficulty();
        const values = [myBest, threshold, teamBest, networkDifficulty]
            .map(value => Number(value) || 0)
            .filter(value => value > 0);

        if (values.length === 0) {
            return buildFocusCard(
                "Difficulty Chase",
                "--",
                buildMetricList([
                    { label: "Need to beat now", value: "--" },
                    { label: "Your best since snapshot", value: "--" },
                    { label: "Team reserve best", value: "--" }
                ]),
                "The live threshold appears once the unpaid Work Set has difficulty data."
            );
        }

        const maxValue = Math.max(...values) * 1.05;
        const logPosition = (value) => {
            if (!value || value <= 0 || !maxValue) return 0;
            return (Math.log10(value + 1) / Math.log10(maxValue + 1)) * 100;
        };
        const progressPercent = threshold ? Math.min(100, logPosition(Math.min(myBest, threshold))) : 0;

        return `
            <div class="mode-focus-card">
                <div class="mode-focus-kicker">Difficulty Chase</div>
                <div class="mode-focus-value">${threshold ? `${formatDifficultyDisplay(myBest)} / ${formatDifficultyDisplay(threshold)}` : formatDifficultyDisplay(myBest)}</div>
                <div class="gauge-wrap">
                    <div class="gauge-rail">
                        <div class="gauge-fill" style="width:${progressPercent}%;"></div>
                        ${threshold ? `<div class="gauge-marker threshold" style="left:${logPosition(threshold)}%;"></div>` : ""}
                        ${myBest ? `<div class="gauge-marker mine" style="left:${logPosition(myBest)}%;"></div>` : ""}
                        ${teamBest ? `<div class="gauge-marker team" style="left:${logPosition(teamBest)}%;"></div>` : ""}
                        ${networkDifficulty ? `<div class="gauge-marker network" style="left:${logPosition(networkDifficulty)}%;"></div>` : ""}
                    </div>
                    <div class="gauge-labels">
                        <div class="gauge-label"><span><span class="gauge-chip mine"></span>Your best hit</span><strong>${formatDifficultyDisplay(myBest)}</strong></div>
                        <div class="gauge-label"><span><span class="gauge-chip threshold"></span>Current reserve floor</span><strong>${getCurrentOnDeckThresholdDisplay()}</strong></div>
                        <div class="gauge-label"><span><span class="gauge-chip team"></span>Best share on the team</span><strong>${formatDifficultyDisplay(teamBest)}</strong></div>
                        <div class="gauge-label"><span><span class="gauge-chip network"></span>Bitcoin network difficulty</span><strong>${formatDifficultyDisplay(networkDifficulty)}</strong></div>
                    </div>
                </div>
                <div class="mode-focus-note">Log-scale view. Clearing the reserve floor is provisional; reaching Bitcoin network difficulty finds a real block.</div>
            </div>
        `;
    }

    function describeHealthAssessment(localDiagnostics) {
        const reasons = Array.isArray(localDiagnostics?.rejectionReasons) ? localDiagnostics.rejectionReasons : [];
        const totalRejected = Number(localDiagnostics?.rejectedCount) || 0;
        const lastRejectedUtc = localDiagnostics?.lastRejectedUtc ? new Date(localDiagnostics.lastRejectedUtc).getTime() : null;
        const lastRotationUtc = latestNetworkState?.lastRotationUtc ? new Date(latestNetworkState.lastRotationUtc).getTime() : null;
        const secondsSinceRotation = lastRotationUtc ? (Date.now() - lastRotationUtc) / 1000 : null;
        const secondsAfterRotationForLastReject = (lastRejectedUtc && lastRotationUtc) ? (lastRejectedUtc - lastRotationUtc) / 1000 : null;
        const topReason = reasons[0]?.reason || null;

        if (totalRejected === 0) {
            return {
                label: "Stable",
                note: "No recent local rejects.",
                detail: "Healthy"
            };
        }

        const transitionNoise = ["Payout mismatch", "Wrong parent block"];
        if (topReason && transitionNoise.includes(topReason) && secondsAfterRotationForLastReject != null && secondsAfterRotationForLastReject <= 60) {
            return {
                label: "Transition Noise",
                note: `${topReason} clustered right after a round or tip change is usually normal.`,
                detail: "Usually benign"
            };
        }

        if (topReason === "Solo fallback template") {
            return {
                label: "Template Churn",
                note: "This usually means DATUM kept miners on local fallback work instead of the GridPool coinbase split.",
                detail: "Needs attention"
            };
        }

        return {
            label: secondsSinceRotation != null && secondsSinceRotation <= 60
                ? "Warm-up"
                : "Attention",
            note: topReason ? `Top recent reject: ${topReason}.` : "Recent rejects need review.",
            detail: secondsSinceRotation != null && secondsSinceRotation <= 60 ? "Early round" : "Persistent issue"
        };
    }

    function buildWindowChanceRows(ratePerSecond, windows) {
        return buildMetricList(windows.map(window => ({
            label: window.label,
            value: formatChanceDetail(poissonProbabilityAtLeastOne(ratePerSecond, window.seconds))
        })));
    }

