@page "{addr?}"
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>GridPool</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --bg-color: #080a0d;
            --panel-color: rgba(18, 23, 25, 0.92);
            --panel-soft: rgba(23, 29, 31, 0.88);
            --text-color: #f1f4ed;
            --text-muted: #a9b2a7;
            --accent-color: #58f07c;
            --accent-secondary: #ffb23f;
            --testnet-color: #67d8ff;
            --highlight-color: #ffffff; /* Bright white for search matches */
            --border-color: rgba(216, 222, 208, 0.14);
            --container-width: 1500px;
        }

        body.network-testnet {
            --accent-color: var(--testnet-color);
            --accent-secondary: #ffcf70;
        }

        body {
            font-family: 'Roboto Mono', monospace;
            background:
                radial-gradient(circle at 18% 10%, rgba(88, 240, 124, 0.12), transparent 32rem),
                radial-gradient(circle at 86% 6%, rgba(255, 178, 63, 0.1), transparent 30rem),
                linear-gradient(rgba(88, 240, 124, 0.025) 1px, transparent 1px),
                linear-gradient(90deg, rgba(88, 240, 124, 0.018) 1px, transparent 1px),
                var(--bg-color);
            background-size: auto, auto, 48px 48px, 48px 48px, auto;
            color: var(--text-color);
            margin: 0;
            padding: 0;
            line-height: 1.4;
        }

        .environment-banner {
            position: sticky;
            top: 0;
            z-index: 1000;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            padding: 9px 18px;
            border-bottom: 1px solid rgba(216, 222, 208, 0.12);
            background:
                linear-gradient(90deg, rgba(88, 240, 124, 0.18), rgba(255, 178, 63, 0.12)),
                rgba(8, 10, 13, 0.94);
            color: var(--text-color);
            font-size: 0.82rem;
            backdrop-filter: blur(16px);
        }

        .environment-banner strong {
            color: var(--accent-color);
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .environment-banner span {
            color: var(--text-muted);
        }

        body.network-testnet .environment-banner {
            background:
                repeating-linear-gradient(135deg, rgba(103, 216, 255, 0.2), rgba(103, 216, 255, 0.2) 10px, rgba(255, 207, 112, 0.15) 10px, rgba(255, 207, 112, 0.15) 20px),
                rgba(8, 10, 13, 0.95);
        }

        .node-header {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) minmax(280px, 420px);
            gap: 24px;
            align-items: center;
            margin-bottom: 24px;
            padding: 24px;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            background:
                linear-gradient(rgba(88, 240, 124, 0.055) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 178, 63, 0.045) 1px, transparent 1px),
                rgba(18, 23, 25, 0.9);
            background-size: 30px 30px, 30px 30px, auto;
            box-shadow: 0 18px 60px rgba(0, 0, 0, 0.3);
        }

        .logo-img {
            width: 118px;
            height: auto;
            opacity: 0.9;
            transition: opacity 0.3s;
        }

        .logo-img:hover {
            opacity: 1;
        }

        .node-title-block h1 {
            margin-bottom: 8px;
            text-align: left;
        }

        .node-network-card {
            justify-self: end;
            display: grid;
            gap: 9px;
            width: 100%;
            padding: 16px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background: rgba(4, 5, 6, 0.42);
        }

        .node-network-card-row {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            color: var(--text-muted);
            font-size: 0.82rem;
        }

        .node-network-card-row strong {
            color: var(--text-color);
            text-align: right;
        }

        .network-badge {
            display: inline-flex;
            width: fit-content;
            min-height: 30px;
            align-items: center;
            padding: 5px 10px;
            border: 1px solid rgba(88, 240, 124, 0.5);
            border-radius: 999px;
            color: var(--accent-color);
            font-weight: 800;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        body.network-testnet .network-badge {
            border-color: rgba(103, 216, 255, 0.58);
            color: var(--testnet-color);
        }

        /* Main Layout */
        .main-container {
            max-width: var(--container-width);
            margin: 0 auto;
            padding: 28px 20px 20px 20px;
        }

        /* Typography */
        h1, h2, h3 {
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        h1 {
            color: var(--accent-color);
            text-align: center;
            margin-top: 0;
            font-size: clamp(2.2rem, 4.5vw, 4.8rem);
            line-height: 0.9;
            letter-spacing: -0.06em;
            text-transform: none;
        }

        .brand-subtitle {
            text-align: left;
            color: var(--text-muted);
            max-width: 720px;
            margin: 0;
            font-size: 1rem;
        }

        h2 {
            font-size: 1.2rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 5px;
            margin-top: 30px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        a {
            color: var(--accent-color);
            text-decoration: none;
            cursor: pointer;
        }

        a:hover {
            text-decoration: underline;
        }

        /* --- TOOLTIPS (INFO ICONS) --- */
        .info-icon {
            display: inline-block;
            width: 18px;
            height: 18px;
            border: 1px solid var(--text-muted);
            border-radius: 50%;
            text-align: center;
            line-height: 16px;
            font-size: 12px;
            color: var(--text-muted);
            cursor: help;
            position: relative;
        }

        .info-icon:hover::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: 125%;
            left: 50%;
            transform: translateX(-50%);
            background: #333;
            color: #fff;
            padding: 8px;
            border-radius: 4px;
            font-size: 12px;
            width: 200px;
            text-transform: none;
            font-weight: normal;
            z-index: 10;
            border: 1px solid var(--accent-color);
        }

        /* Search Section */
        .search-section {
            margin-bottom: 22px;
            text-align: center;
        }

        .search-box-container {
            display: inline-flex;
            border: 1px solid var(--border-color);
            padding: 5px;
            background: #000;
        }

        .search-input {
            background: transparent;
            border: none;
            color: var(--text-color);
            font-family: inherit;
            padding: 8px;
            width: 300px;
            outline: none;
        }

        .search-btn {
            background: var(--accent-color);
            border: none;
            color: #000;
            font-family: inherit;
            padding: 8px 15px;
            font-weight: bold;
            cursor: pointer;
        }

        .search-btn:hover {
            opacity: 0.9;
        }

        /* Search Results Text */
        .search-results {
            margin-top: 15px;
            min-height: 20px;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .result-highlight {
            color: var(--highlight-color);
            font-weight: bold;
        }

        .connect-panel {
            border: 1px solid rgba(189, 89, 255, 0.45);
            background:
                radial-gradient(circle at top right, rgba(189, 89, 255, 0.16), transparent 34%),
                linear-gradient(135deg, rgba(12, 12, 12, 0.98), rgba(20, 12, 24, 0.92));
            padding: 18px;
            margin: 0 0 24px 0;
        }

        .connect-panel[hidden] {
            display: none;
        }

        .connect-panel-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 16px;
        }

        .connect-panel h2,
        .primary-hashrate-section h2 {
            margin: 0;
        }

        .connect-panel-subtitle {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-top: 6px;
            max-width: 760px;
        }

        .status-pill {
            border: 1px solid var(--accent-color);
            color: var(--accent-color);
            padding: 6px 10px;
            font-size: 0.74rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            white-space: nowrap;
            background: rgba(189, 89, 255, 0.08);
        }

        .connect-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
            gap: 18px;
            align-items: stretch;
        }

        .connect-card {
            border: 1px solid var(--border-color);
            background: rgba(0, 0, 0, 0.28);
            padding: 14px;
        }

        .connect-card h3 {
            margin: 0 0 10px 0;
            color: var(--text-muted);
            font-size: 0.86rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .connect-list {
            display: grid;
            gap: 8px;
            color: var(--text-color);
            font-size: 0.92rem;
        }

        .connect-list span {
            color: var(--text-muted);
        }

        .connect-warning {
            margin-top: 12px;
            padding: 10px;
            border: 1px solid rgba(255, 200, 87, 0.35);
            color: #ffc857;
            background: rgba(255, 200, 87, 0.08);
            font-size: 0.86rem;
        }

        .connect-kv-grid {
            display: grid;
            gap: 10px;
        }

        .connect-kv {
            display: grid;
            gap: 4px;
        }

        .connect-kv label {
            color: var(--text-muted);
            font-size: 0.76rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .connect-kv div {
            border: 1px solid var(--border-color);
            background: #000;
            color: var(--accent-color);
            padding: 8px;
            word-break: break-all;
        }

        .connect-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 14px;
        }

        .secondary-btn {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-color);
            font-family: inherit;
            padding: 8px 12px;
            font-weight: 700;
            cursor: pointer;
        }

        .secondary-btn:hover {
            color: var(--accent-color);
            border-color: var(--accent-color);
        }

        .primary-hashrate-section {
            margin: 0 0 28px 0;
        }

        .primary-hashrate-section .chart-container {
            height: 340px;
        }

        .mode-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
            margin: 20px 0 16px 0;
            padding: 14px 16px;
            border: 1px solid var(--border-color);
            background: #0c0c0c;
        }

        .mode-toolbar-left {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .mode-toolbar-label {
            color: var(--text-muted);
            font-size: 0.85rem;
            text-transform: uppercase;
        }

        .mode-toolbar-right {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .mode-status-item strong {
            color: var(--text-color);
            font-weight: 700;
        }

        .mode-intro {
            border-left: 3px solid var(--accent-color);
            padding: 10px 14px;
            margin-bottom: 24px;
            background: rgba(189, 89, 255, 0.08);
            color: var(--text-muted);
        }

        .mode-intro strong {
            color: var(--text-color);
        }

        .mode-summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
            margin-bottom: 28px;
        }

        .mode-card {
            border: 1px solid var(--border-color);
            padding: 15px;
            background: #0c0c0c;
        }

        .mode-card-kicker {
            color: var(--text-muted);
            font-size: 0.78rem;
            text-transform: uppercase;
            margin-bottom: 10px;
            letter-spacing: 1px;
        }

        .mode-card-title {
            font-size: 1rem;
            color: var(--text-color);
            margin-bottom: 8px;
        }

        .mode-card-value {
            font-size: 1.15rem;
            color: var(--accent-color);
            margin-bottom: 8px;
            word-break: break-word;
        }

        .mode-card-detail,
        .mode-card-note {
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .mode-card-note {
            margin-top: 10px;
            min-height: 1em;
        }

        .mode-focus-section {
            margin-bottom: 28px;
        }

        .mode-focus-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
        }

        .mode-focus-card {
            border: 1px solid var(--border-color);
            padding: 15px;
            background: #0c0c0c;
            min-height: 160px;
        }

        .mode-focus-kicker {
            color: var(--text-muted);
            font-size: 0.78rem;
            text-transform: uppercase;
            margin-bottom: 10px;
            letter-spacing: 1px;
        }

        .mode-focus-value {
            font-size: 1.15rem;
            color: var(--accent-color);
            margin-bottom: 10px;
            word-break: break-word;
        }

        .mode-focus-body {
            color: var(--text-color);
            font-size: 0.9rem;
        }

        .mode-focus-metric {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 14px;
            color: var(--text-muted);
            font-size: 0.84rem;
            margin-bottom: 6px;
        }

        .mode-focus-metric strong {
            color: var(--text-color);
            font-weight: 700;
            text-align: right;
        }

        .mode-focus-note {
            color: var(--text-muted);
            font-size: 0.82rem;
            margin-top: 10px;
        }

        .mode-focus-list {
            margin-top: 10px;
            display: grid;
            gap: 6px;
        }

        .mode-focus-list-item {
            color: var(--text-muted);
            font-size: 0.82rem;
            border-top: 1px solid #1d1d1d;
            padding-top: 6px;
        }

        .mode-focus-card.hero,
        .mode-focus-card.wide {
            grid-column: 1 / -1;
        }

        .mode-focus-card.hero {
            background: radial-gradient(circle at top left, rgba(189, 89, 255, 0.18), rgba(12, 12, 12, 0.96) 55%);
            border-color: rgba(189, 89, 255, 0.45);
        }

        .mode-focus-rich {
            display: grid;
            gap: 12px;
        }

        .mode-hero-title {
            font-size: 1.55rem;
            color: var(--text-color);
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .mode-hero-copy {
            color: var(--text-muted);
            font-size: 0.92rem;
            max-width: 70ch;
        }

        .mode-hero-metrics {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 10px;
        }

        .mode-mini-panel {
            border: 1px solid #1d1d1d;
            padding: 10px 12px;
            background: rgba(0, 0, 0, 0.28);
        }

        .mode-mini-panel strong {
            display: block;
            color: var(--text-color);
            font-size: 0.94rem;
            margin-top: 4px;
        }

        .mode-mini-kicker {
            color: var(--text-muted);
            font-size: 0.74rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .metric-list {
            display: grid;
            gap: 7px;
        }

        .metric-row {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 14px;
            color: var(--text-muted);
            font-size: 0.84rem;
        }

        .metric-row strong {
            color: var(--text-color);
            text-align: right;
            font-size: 0.9rem;
        }

        .shortcut-strip {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 12px;
        }

        .shortcut-chip {
            border: 1px solid var(--border-color);
            background: #0c0c0c;
            color: var(--text-color);
            padding: 8px 10px;
            cursor: pointer;
            font-family: inherit;
            text-align: left;
            min-width: 180px;
        }

        .shortcut-chip.active {
            border-color: var(--accent-color);
            box-shadow: inset 0 0 0 1px var(--accent-color);
        }

        .shortcut-chip-label {
            display: block;
            color: var(--text-muted);
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 4px;
        }

        .shortcut-chip-value {
            display: block;
            color: var(--text-color);
            font-size: 0.9rem;
        }

        .shortcut-chip-note {
            display: block;
            color: var(--accent-color);
            font-size: 0.78rem;
            margin-top: 4px;
        }

        .gauge-wrap {
            display: grid;
            gap: 12px;
        }

        .gauge-rail {
            position: relative;
            height: 12px;
            background: linear-gradient(90deg, rgba(57, 217, 138, 0.18), rgba(189, 89, 255, 0.2), rgba(255, 200, 87, 0.22));
            border: 1px solid var(--border-color);
            overflow: visible;
        }

        .gauge-fill {
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            background: linear-gradient(90deg, rgba(57, 217, 138, 0.68), rgba(189, 89, 255, 0.68));
        }

        .gauge-marker {
            position: absolute;
            top: -5px;
            width: 2px;
            height: 20px;
            background: var(--text-color);
            transform: translateX(-1px);
        }

        .gauge-marker.threshold {
            background: #39d98a;
        }

        .gauge-marker.mine {
            background: var(--accent-color);
        }

        .gauge-marker.team {
            background: #ffc857;
        }

        .gauge-marker.network {
            background: #4ea8de;
        }

        .gauge-labels {
            display: grid;
            gap: 7px;
        }

        .gauge-label {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 12px;
            color: var(--text-muted);
            font-size: 0.82rem;
        }

        .gauge-label strong {
            color: var(--text-color);
        }

        .gauge-chip {
            display: inline-block;
            width: 10px;
            height: 10px;
            margin-right: 8px;
        }

        .gauge-chip.threshold { background: #39d98a; }
        .gauge-chip.mine { background: var(--accent-color); }
        .gauge-chip.team { background: #ffc857; }
        .gauge-chip.network { background: #4ea8de; }

        .technical-disclosure {
            margin-top: 10px;
            margin-bottom: 30px;
            border: 1px solid var(--border-color);
            background: #0c0c0c;
        }

        .technical-disclosure summary {
            list-style: none;
            cursor: pointer;
            padding: 14px 16px;
            color: var(--text-color);
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .technical-disclosure summary::-webkit-details-marker {
            display: none;
        }

        .technical-disclosure[open] summary {
            border-bottom: 1px solid var(--border-color);
        }

        .technical-summary-note {
            color: var(--text-muted);
            font-size: 0.8rem;
            font-weight: 400;
            text-transform: none;
        }

        .technical-content {
            padding: 0 0 16px 0;
        }

        .list-disclosure {
            margin-top: 26px;
        }

        /* Info Grids */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .info-box {
            border: 1px solid var(--border-color);
            padding: 15px;
        }

        .info-box h3 {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin: 0 0 10px 0;
        }

        .info-value {
            font-size: 1.1rem;
            word-break: break-all;
        }

        .accent-value {
            color: var(--accent-color);
        }

        .local-mining-sources {
            display: grid;
            gap: 6px;
            margin: 8px 0 12px;
        }

        .local-source-panel {
            margin: 18px 0 26px;
        }

        .source-card-grid {
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 10px;
        }

        .source-card-grid .local-mining-source-row {
            grid-template-columns: 1fr auto;
            padding: 12px;
            border: 1px solid var(--border-color);
            background: rgba(0, 0, 0, 0.28);
        }

        .source-card-grid .local-mining-source-meta {
            grid-column: 1 / -1;
            text-align: left;
        }

        .local-mining-source-row {
            display: grid;
            grid-template-columns: 78px 72px minmax(0, 1fr);
            gap: 8px;
            align-items: baseline;
            padding: 6px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 0.78rem;
        }

        .local-mining-source-row:last-child {
            border-bottom: 0;
        }

        .local-mining-source-name {
            color: var(--text-color);
        }

        .local-mining-source-meta {
            color: var(--text-muted);
            text-align: right;
        }

        .key-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #000;
            padding: 5px;
            font-size: 0.85rem;
            border: 1px solid var(--border-color);
        }

        .copy-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
        }

        .copy-btn:hover {
            color: var(--accent-color);
        }

        /* Charts */
        .charts-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .section-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 30px;
            margin-bottom: 12px;
        }

        .section-toolbar h2 {
            margin: 0;
        }

        .chart-container {
            border: 1px solid var(--border-color);
            padding: 15px;
            height: 250px;
            min-width: 0;
            overflow: hidden;
        }

        .round-history-note {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 10px;
        }

        .round-history-content {
            display: grid;
            gap: 18px;
            min-width: 0;
        }

        .round-history-primary {
            display: grid;
            gap: 16px;
            min-width: 0;
        }

        .round-history-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }

        .round-history-scroller {
            display: flex;
            gap: 12px;
            overflow-x: auto;
            padding-bottom: 8px;
            margin-bottom: 16px;
        }

        .round-card {
            border: 1px solid var(--border-color);
            background: #0c0c0c;
            padding: 12px;
            cursor: pointer;
            min-height: 128px;
            flex: 1 0 clamp(220px, 20vw, 340px);
            max-width: 360px;
            color: var(--text-color);
            font-family: inherit;
            text-align: left;
            appearance: none;
        }

        .round-card:hover {
            border-color: var(--text-muted);
        }

        .round-card.active {
            border-color: var(--accent-color);
            box-shadow: inset 0 0 0 1px var(--accent-color);
        }

        .round-card.orphaned {
            opacity: 0.6;
            border-style: dashed;
        }

        .round-card.orphaned.active {
            opacity: 0.8;
        }

        .round-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 10px;
        }

        .round-card-title {
            font-weight: bold;
            color: var(--text-color);
        }

        .round-card-link {
            color: var(--accent-color);
            font-size: 0.76rem;
            text-decoration: none;
        }

        .round-card-link:hover {
            text-decoration: underline;
        }

        .round-kind-pill {
            font-size: 0.72rem;
            border: 1px solid var(--border-color);
            color: var(--accent-color);
            padding: 2px 6px;
            text-transform: uppercase;
        }

        .round-kind-pill.orphaned {
            color: #ff9f1c;
            border-color: #ff9f1c;
        }

        .round-card-meta,
        .round-card-preview {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .round-card-preview strong {
            color: var(--text-color);
        }

        .round-detail {
            border: 1px solid var(--border-color);
            padding: 16px;
            background: #0c0c0c;
        }

        .round-detail-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
            margin-bottom: 18px;
        }

        .round-detail-box {
            border: 1px solid var(--border-color);
            padding: 12px;
            background: #111;
        }

        .round-detail-box h3 {
            margin: 0 0 8px 0;
            font-size: 0.78rem;
            color: var(--text-muted);
        }

        .round-detail-value {
            font-size: 0.95rem;
            word-break: break-word;
        }

        .round-detail-columns {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .round-detail-section h3 {
            margin: 0 0 10px 0;
        }

        .round-detail-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 18px;
            flex-wrap: wrap;
        }

        .round-detail-head h3 {
            margin: 0 0 6px 0;
        }

        .round-detail-subline {
            color: var(--text-muted);
            font-size: 0.85rem;
            word-break: break-word;
        }

        .round-detail-warning {
            color: #ff9f1c;
            border: 1px dashed #ff9f1c;
            padding: 10px 12px;
            margin-bottom: 16px;
            font-size: 0.85rem;
            background: rgba(255, 159, 28, 0.08);
        }

        .round-history-chart {
            margin-top: 16px;
        }

        .round-history-chart-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 16px;
            min-width: 0;
        }

        .round-history-chart-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }

        .round-history-chart-toolbar h3 {
            margin: 0;
            font-size: 0.95rem;
            color: var(--text-muted);
        }

        .round-history-chart canvas {
            width: 100%;
            height: 220px;
            display: block;
            max-width: 100%;
        }

        .round-history-search-note {
            color: var(--accent-color);
            font-size: 0.85rem;
            margin-top: 8px;
        }

        .round-history-empty {
            color: var(--text-muted);
            border: 1px dashed var(--border-color);
            padding: 16px;
            text-align: center;
        }

        /* Tables */
        .table-container {
            overflow-x: auto;
        }

        .full-label {
            white-space: nowrap;
        }

        .list-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: -6px 0 10px 0;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .list-summary-note {
            min-height: 1em;
        }

        .view-toggle {
            display: inline-flex;
            flex-wrap: wrap;
            border: 1px solid var(--border-color);
            background: #000;
            max-width: 100%;
        }

        .toggle-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-family: inherit;
            padding: 6px 10px;
            cursor: pointer;
        }

        .toggle-btn.active {
            background: var(--accent-color);
            color: #000;
            font-weight: bold;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        #winners-list,
        #ondeck-list {
            table-layout: fixed;
        }

        #winners-list th:first-child,
        #winners-list td:first-child,
        #ondeck-list th:first-child,
        #ondeck-list td:first-child {
            width: 8.5rem;
        }

        .compact-label {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        th {
            color: var(--text-muted);
            font-weight: normal;
            padding: 10px 5px;
            border-bottom: 1px solid var(--border-color);
        }

        td {
            padding: 10px 5px;
            border-bottom: 1px solid #222;
        }

        tr:hover td {
            background-color: #1a1a1a;
        }

        .static-row td {
            color: var(--accent-color);
            font-style: italic;
        }

        /* Search Highlight Row Style */
        tr.highlight-row td {
            background-color: rgba(189, 89, 255, 0.2);
            color: var(--highlight-color);
            font-weight: bold;
            border-bottom: 1px solid var(--highlight-color);
        }

        .omitted-row td {
            color: var(--text-muted);
            text-align: center;
            font-style: italic;
        }

        /* Footer */
        footer {
            margin-top: 50px;
            text-align: center;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        footer a {
            margin: 0 10px;
        }

        /* Modals */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: var(--bg-color);
            border: 2px solid var(--accent-color);
            padding: 30px;
            max-width: 600px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            position: relative;
        }

        .close-modal {
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 1.5rem;
            color: var(--accent-color);
            cursor: pointer;
        }

        /* --- RESPONSIVE --- */
        @@media (max-width: 1100px) {
            .node-header {
                grid-template-columns: auto minmax(0, 1fr);
            }

            .node-network-card {
                grid-column: 1 / -1;
                justify-self: stretch;
            }

            .charts-section {
                grid-template-columns: 1fr;
            }

            .round-detail-columns {
                grid-template-columns: 1fr;
            }

            .round-history-toolbar {
                align-items: flex-start;
            }

            .round-history-chart-grid {
                grid-template-columns: 1fr;
            }

            .connect-grid {
                grid-template-columns: 1fr;
            }

            .list-toolbar {
                flex-direction: column;
                align-items: flex-start;
            }

            .mode-toolbar {
                align-items: flex-start;
            }

            .mode-toolbar-right {
                width: 100%;
            }

            .mode-hero-title {
                font-size: 1.2rem;
            }
        }

        @@media (max-width: 700px) {
            .environment-banner {
                align-items: flex-start;
                flex-direction: column;
                gap: 4px;
            }

            .node-header {
                grid-template-columns: 1fr;
                padding: 18px;
            }

            .logo-img {
                width: 88px;
            }

            .node-title-block h1 {
                font-size: 2.5rem;
            }

            .node-network-card-row {
                display: grid;
            }

            .node-network-card-row strong {
                text-align: left;
            }

            .brand-subtitle {
                font-size: 0.85rem;
                margin-bottom: 20px;
            }

            .search-box-container {
                display: flex;
                width: 100%;
                max-width: 100%;
            }

            .search-input {
                width: 100%;
                min-width: 0;
            }

            .round-history-chart-toolbar {
                align-items: stretch;
            }

            .round-history-chart-toolbar .view-toggle {
                width: 100%;
            }

            .round-history-chart-toolbar .toggle-btn {
                flex: 1 1 auto;
                text-align: center;
            }

            .connect-panel-header {
                display: grid;
            }

            .status-pill {
                justify-self: flex-start;
            }

            .connect-actions {
                display: grid;
            }

            .primary-hashrate-section .chart-container {
                height: 310px;
            }
        }
    </style>
</head>
<body>

<div class="environment-banner" id="environment-banner">
    <strong id="environment-banner-title">Public Beta</strong>
    <span id="environment-banner-copy">Experimental non-custodial mining protocol. Mainnet payouts are real; verify your setup.</span>
</div>

<div class="main-container">
    <header class="node-header">
        <img src="logo.png" alt="Grid Labs" class="logo-img"/>
        <div class="node-title-block">
            <div class="network-badge" id="network-badge">Public beta</div>
            <h1 id="brand-title">GridPool</h1>
            <div class="brand-subtitle" id="brand-subtitle">The pool for cypherpunks. Sovereign templates, shared variance, no pool wallet.</div>
        </div>
        <div class="node-network-card" aria-label="Node network summary">
            <div class="node-network-card-row">
                <span>Network</span>
                <strong id="header-network-name">Loading...</strong>
            </div>
            <div class="node-network-card-row">
                <span>Node</span>
                <strong id="header-node-endpoint">--</strong>
            </div>
            <div class="node-network-card-row">
                <span>Snapshot mode</span>
                <strong id="header-round-mode">--</strong>
            </div>
        </div>
    </header>

    <div class="mode-toolbar">
        <div class="mode-toolbar-left">
            <div class="mode-toolbar-label">View</div>
            <div class="view-toggle">
                <button class="toggle-btn" id="mode-lottery-btn" onclick="setUiMode('lottery')">LOTTERY</button>
                <button class="toggle-btn" id="mode-business-btn" onclick="setUiMode('business')">BUSINESS</button>
                <button class="toggle-btn" id="mode-nerd-btn" onclick="setUiMode('nerd')">NERD</button>
            </div>
        </div>
        <div class="mode-toolbar-right">
            <div class="mode-status-item">Snapshot <strong id="mode-header-round">--</strong></div>
            <div class="mode-status-item">Trigger <strong id="mode-header-trigger">--</strong></div>
            <div class="mode-status-item">Team <strong id="mode-header-hashrate">--</strong></div>
            <div class="mode-status-item">Peers <strong id="mode-header-peers">--</strong></div>
        </div>
    </div>

    <div class="mode-intro" id="mode-intro">Loading view...</div>

    <div class="search-section">
        <div class="search-box-container">
            <input type="text" id="search-input" class="search-input" placeholder="Enter Wallet Address..."
                   onkeypress="if(event.key === 'Enter') performSearch()">
            <button class="search-btn" onclick="performSearch()">SEARCH</button>
        </div>
        <div id="search-results" class="search-results"></div>
        <div id="local-miner-shortcuts" class="shortcut-strip" hidden></div>
    </div>

    <section class="local-source-panel">
        <div class="section-toolbar">
            <h2>Local Mining Clients</h2>
        </div>
        <div class="local-mining-sources source-card-grid" data-local-mining-sources></div>
    </section>

    <section class="connect-panel" id="connect-panel">
        <div class="connect-panel-header">
            <div>
                <h2>Connect Your Miner</h2>
                <div class="connect-panel-subtitle">
                    Connect through a supported sovereign template builder, then search your payout address above to switch into your personal dashboard.
                    No cookies needed: bookmarked address links hide this setup panel automatically.
                </div>
            </div>
            <div class="status-pill">Multiple mining paths</div>
        </div>
        <div class="connect-grid">
            <div class="connect-card">
                <h3>Supported Paths</h3>
                <div class="connect-list">
                    <div><strong>Works now:</strong> DATUM Gateway, GridPool CKPool, Hydrapool, native Stratum V2, and direct HTTP integrations.</div>
                    <div><strong>Extensible:</strong> Public Pool, FutureBit, and other sovereign template builders can integrate through the <a href="https://github.com/gridlabs-science/boot-protocol/blob/main/docs/hydrapool-http-submission.md" target="_blank" rel="noopener noreferrer">HTTP API spec</a>.</div>
                    <div><span>Raw Stratum V1 directly from an ASIC is not supported here. This protocol is for miners who can build their own block templates.</span></div>
                </div>
                <div class="connect-warning">
                    Sovereign-miner assumption: your DATUM or compatible server builds the template, owns slot 0, submits found blocks to your Bitcoin node, and submits share proofs to GridPool.
                </div>
            </div>
            <div class="connect-card">
                <h3>This Node</h3>
                <div class="connect-kv-grid">
                    <div class="connect-kv">
                        <label>Host</label>
                        <div id="connect-host">Loading...</div>
                    </div>
                    <div class="connect-kv">
                        <label>Port</label>
                        <div id="connect-port">Loading...</div>
                    </div>
                    <div class="connect-kv">
                        <label>Pool Pubkey</label>
                        <div id="connect-pubkey-display">Loading...</div>
                    </div>
                </div>
                <div class="connect-actions">
                    <button class="search-btn" onclick="copyPubKey('connect-copy-feedback')">COPY PUBKEY</button>
                    <button class="secondary-btn" onclick="focusAddressSearch()">I HAVE A PAYOUT ADDRESS</button>
                    <button class="secondary-btn" onclick="toggleModal('help-modal')">SETUP HELP</button>
                </div>
                <div id="connect-copy-feedback" class="search-results"></div>
            </div>
        </div>
    </section>

    <section class="primary-hashrate-section" id="primary-hashrate-section">
        <div class="chart-container round-history-chart" id="round-hashrate-panel">
            <div class="round-history-chart-toolbar">
                <h3>Estimated Hashrate Through Time</h3>
                <div class="view-toggle">
                    <button class="toggle-btn" id="hashrate-window-6h-btn" onclick="setHashrateWindow('6h')">6H</button>
                    <button class="toggle-btn active" id="hashrate-window-24h-btn" onclick="setHashrateWindow('24h')">24H</button>
                    <button class="toggle-btn" id="hashrate-window-7d-btn" onclick="setHashrateWindow('7d')">7D</button>
                    <button class="toggle-btn" id="hashrate-window-30d-btn" onclick="setHashrateWindow('30d')">30D</button>
                    <button class="toggle-btn" id="hashrate-window-all-btn" onclick="setHashrateWindow('all')">ALL</button>
                </div>
                <div class="view-toggle">
                    <button class="toggle-btn active" id="hashrate-scale-linear-btn" onclick="setHashrateScaleMode('linear')">LINEAR</button>
                    <button class="toggle-btn" id="hashrate-scale-log-btn" onclick="setHashrateScaleMode('log')">LOG</button>
                </div>
            </div>
            <canvas id="roundHashrateChart"></canvas>
            <div class="round-history-search-note" id="round-hashrate-chart-note"></div>
        </div>
    </section>

    <div class="mode-summary-grid">
        <div class="mode-card">
            <div class="mode-card-kicker" id="mode-card-1-kicker">Loading</div>
            <div class="mode-card-title" id="mode-card-1-title">--</div>
            <div class="mode-card-value" id="mode-card-1-value">--</div>
            <div class="mode-card-detail" id="mode-card-1-detail">--</div>
            <div class="mode-card-note" id="mode-card-1-note"></div>
        </div>
        <div class="mode-card">
            <div class="mode-card-kicker" id="mode-card-2-kicker">Loading</div>
            <div class="mode-card-title" id="mode-card-2-title">--</div>
            <div class="mode-card-value" id="mode-card-2-value">--</div>
            <div class="mode-card-detail" id="mode-card-2-detail">--</div>
            <div class="mode-card-note" id="mode-card-2-note"></div>
        </div>
        <div class="mode-card">
            <div class="mode-card-kicker" id="mode-card-3-kicker">Loading</div>
            <div class="mode-card-title" id="mode-card-3-title">--</div>
            <div class="mode-card-value" id="mode-card-3-value">--</div>
            <div class="mode-card-detail" id="mode-card-3-detail">--</div>
            <div class="mode-card-note" id="mode-card-3-note"></div>
        </div>
    </div>

    <section class="mode-focus-section">
        <div class="section-toolbar">
            <h2 id="mode-focus-heading">Mode Focus</h2>
        </div>
        <div class="mode-focus-grid" id="mode-focus-grid"></div>
    </section>

    <details class="technical-disclosure" id="technical-disclosure">
        <summary>
            <span id="technical-details-title">Show Technical Details</span>
            <span class="technical-summary-note" id="technical-details-summary-note">State IDs, peer status, diagnostics, and full protocol tooling.</span>
        </summary>
        <div class="technical-content">
    <div class="info-grid">
        <div class="info-box">
            <h3>🏆 All-Time Best Diff</h3>
            <div class="info-value accent-value" id="record-diff">--</div>
            <h3>Miner</h3>
            <div class="info-value" id="record-miner">None</div>
            <h3>Time (UTC)</h3>
            <div class="info-value" id="record-time">--</div>
        </div>

        <div class="info-box">
            <h3>📡 Connection Info</h3>
            <div>Host: <span class="accent-value" id="server-host">Loading...</span></div>
            <div>Port: <span class="accent-value" id="server-port">Loading...</span></div>
            <h3 style="margin-top: 10px;">Pool Pubkey</h3>
            <div class="key-container">
                <span id="server-pubkey-display">Loading...</span>
                <button onclick="copyPubKey()" class="copy-btn" title="Copy Key">📋</button>
            </div>
            <div id="copy-feedback" style="color: var(--accent-color); height: 15px; font-size: 0.7em;"></div>
        </div>

        <div class="info-box">
            <h3>🕸 Network State</h3>
            <div>Self: <span class="accent-value" id="self-endpoint">--</span></div>
            <div>Network: <span class="accent-value" id="network-id">Loading...</span></div>
            <div>Consensus: <span class="accent-value" id="consensus-version">--</span></div>
            <div>State Schema: <span class="accent-value" id="state-schema-version">--</span></div>
            <div>Transport/API: <span class="accent-value" id="transport-api-version">--</span></div>
            <div>Release: <span class="accent-value" id="release-version">--</span></div>
            <div>Current Snapshot: <span class="accent-value" id="current-round-number">--</span></div>
            <div>Template Slots: <span class="accent-value" id="template-slot-count">Loading...</span></div>
            <div>Peers: <span class="accent-value" id="peer-count">0</span></div>
            <div>Current State: <span class="accent-value" id="current-state-id">Loading...</span></div>
            <div>Candidate State: <span class="accent-value" id="candidate-state-id">Loading...</span></div>
            <div>Snapshot Age: <span class="accent-value" id="current-round-age">--</span></div>
            <div>Work Set Avg Hashrate: <span class="accent-value" id="current-round-hashrate">--</span></div>
            <div>Local Connected Hashrate: <span class="accent-value" id="local-mining-hashrate">--</span></div>
            <h3 style="margin-top: 10px;">Local Mining Sources</h3>
            <div class="local-mining-sources" data-local-mining-sources></div>
            <h3 style="margin-top: 10px;">Local DATUM Diagnostics</h3>
            <div>Window: <span class="accent-value" id="datum-diagnostic-window">--</span></div>
            <div>Accepted: <span class="accent-value" id="datum-accepted-count">--</span></div>
            <div>Work Set Accepted: <span class="accent-value" id="datum-ondeck-count">--</span></div>
            <div>Rejected: <span class="accent-value" id="datum-rejected-count">--</span></div>
            <div>Acceptance: <span class="accent-value" id="datum-acceptance-rate">--</span></div>
            <div>Test Trigger: <span class="accent-value" id="testing-trigger-status">Loading...</span></div>
            <div>Last Test Block: <span class="accent-value" id="last-testing-trigger-block">--</span></div>
            <div>Payment Mode: <span class="accent-value" id="launch-ready-status">Loading...</span></div>
            <h3 style="margin-top: 10px;">Commitment Preview</h3>
            <div class="info-value" id="commitment-preview">Loading...</div>
            <div class="search-results" id="commitment-note"></div>
            <div class="search-results" id="testing-trigger-note"></div>
            <div class="search-results" id="launch-readiness-note"></div>
            <div class="search-results" id="round-hashrate-note">Team estimate uses the current unpaid Work Set share window. Local source estimates prefer vardiff work accounting; sparse proof estimates remain hidden while warming up.</div>
            <div class="search-results" id="datum-rejection-note"></div>
        </div>
    </div>

    <section id="difficulty-section">
        <div class="section-toolbar">
            <h2>Difficulty Distribution</h2>
            <div class="view-toggle">
                <button class="toggle-btn active" id="chart-linear-btn" onclick="setChartScaleMode('linear')">LINEAR</button>
                <button class="toggle-btn" id="chart-log-btn" onclick="setChartScaleMode('log')">LOG</button>
